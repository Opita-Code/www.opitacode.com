---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en';
  schema?: Record<string, any> | Record<string, any>[];
}

const { title, description, lang, schema } = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth scroll-pt-24">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#09090b" />
    <!-- Brand favicon: `>_` terminal prompt in violet (no graphical logo) -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2280%22 fill=%22%238b5cf6%22 font-family=%22monospace%22 font-weight=%22bold%22>>_</text></svg>" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <!-- SEO & Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Opita Code" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/og-image.svg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.svg', Astro.site)} />
    
    <!-- i18n Alternate Links -->
    <link rel="alternate" hreflang="es" href={`${Astro.site || ''}/es`} />
    <link rel="alternate" hreflang="en" href={`${Astro.site || ''}/en`} />
    <link rel="alternate" hreflang="x-default" href={`${Astro.site || ''}/es`} />

    <!-- JSON-LD -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Theme Manager -->
    <script is:inline>
      if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.add('light');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col font-sans">
    <header class="border-b border-border-base bg-bg-base/80 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href={`/${lang}`} class="flex items-center gap-3 group">
          <img src="/opita-code-stacked-white-v4.png" alt="Opita Code" class="h-8 w-auto" />
          <span class="text-text-base font-display font-bold transition-colors hidden sm:inline">OPITA&nbsp;CODE</span>
        </a>
        <nav class="hidden md:flex gap-8 text-sm font-medium items-center">
          <a href={`/${lang}#ecosystem`} class="text-text-muted hover:text-text-base transition-colors">{lang === 'es' ? 'Ecosistema' : 'Ecosystem'}</a>
          <a href={`/${lang}#kernel`} class="text-text-muted hover:text-text-base transition-colors">{lang === 'es' ? 'Kernel' : 'Kernel'}</a>
          <a href={`/${lang}/blog`} class="text-text-muted hover:text-text-base transition-colors">{lang === 'es' ? 'Blog' : 'Blog'}</a>
          <a href={`/${lang}#contact`} class="text-text-muted hover:text-text-base transition-colors">{lang === 'es' ? 'Contacto' : 'Contact'}</a>
          <a href={`https://github.com/Opita-Code`} target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-text-base transition-colors flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
            GitHub
          </a>
          <div class="h-4 w-px bg-border-base"></div>
          <a href="https://cuenta.opitacode.com" class="px-5 py-2 rounded-md bg-zinc-800/80 hover:bg-zinc-700 border border-zinc-700 font-mono text-xs text-white transition-all hover:border-corporate-700/30">{lang === 'es' ? 'Mi Cuenta' : 'My Account'}</a>
        </nav>
        <div class="flex items-center gap-4">
          <div class="text-xs font-mono bg-bg-muted px-2 py-1 rounded text-text-muted border border-border-base flex items-center h-full">
            <a href="/es" class={lang === 'es' ? 'font-bold text-text-base' : ''}>ES</a>
            <span class="opacity-50 mx-1">/</span>
            <a href="/en" class={lang === 'en' ? 'font-bold text-text-base' : ''}>EN</a>
          </div>
          <ThemeToggle />
        </div>
      </div>
    </header>
    
    <main class="flex-grow">
      <slot />
    </main>

    <footer class="border-t border-border-base bg-bg-surface/30 pt-16 pb-8 relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-10 mb-12">
          <div class="col-span-2 md:col-span-1">
            <a href={`/${lang}`} class="flex items-center gap-2 mb-4">
              <img src="/opita-code-stacked-white-v4.png" alt="Opita Code" class="h-6 w-auto" />
            </a>
            <p class="text-sm text-text-muted leading-relaxed">
              {lang === 'es'
                ? 'Software práctico para negocios reales. Construido desde Colombia con identidad local y ambición global.'
                : 'Practical software for real businesses. Built from Colombia with local identity and global ambition.'}
            </p>
          </div>
          <div>
            <h4 class="text-sm font-mono text-text-muted uppercase tracking-widest mb-4">{lang === 'es' ? 'Productos' : 'Products'}</h4>
            <ul class="space-y-2.5 text-sm">
              <li><a href="https://vibe.opitacode.com" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-text-base transition-colors">Vibe Studio</a></li>
              <li><a href="https://market.opitacode.com" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-text-base transition-colors">Opita Market</a></li>
              <li><a href="https://sociedad.opitacode.com" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-text-base transition-colors">Sociedad Opita</a></li>
              <li><a href="https://developer.opitacode.com" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-text-base transition-colors">Developer</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-sm font-mono text-text-muted uppercase tracking-widest mb-4">{lang === 'es' ? 'Open Source' : 'Open Source'}</h4>
            <ul class="space-y-2.5 text-sm">
              <li><a href="https://github.com/Opita-Code/dark-memory-mcp" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-text-base transition-colors">dark-memory-mcp</a></li>
              <li><a href="https://github.com/Opita-Code/dark-research-mcp" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-text-base transition-colors">dark-research-mcp</a></li>
              <li><a href="https://github.com/Opita-Code/ocais" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-text-base transition-colors">ocais</a></li>
              <li><a href="https://github.com/Opita-Code" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-text-base transition-colors">GitHub Org →</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-sm font-mono text-text-muted uppercase tracking-widest mb-4">{lang === 'es' ? 'Legal' : 'Legal'}</h4>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/legal/privacidad.html" class="text-text-muted hover:text-text-base transition-colors">{lang === 'es' ? 'Privacidad' : 'Privacy'}</a></li>
              <li><a href="/legal/terminos.html" class="text-text-muted hover:text-text-base transition-colors">{lang === 'es' ? 'Términos' : 'Terms'}</a></li>
              <li><a href="/legal/cookies.html" class="text-text-muted hover:text-text-base transition-colors">{lang === 'es' ? 'Cookies' : 'Cookies'}</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-border-base pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <img src="/opita-code-stacked-white-v4.png" alt="Opita Code" class="h-5 w-auto opacity-80" />
            <span class="text-sm text-text-muted font-medium">© {new Date().getFullYear()} Opita Code.</span>
          </div>
          <div class="text-sm text-corporate-800">
            {lang === 'es' ? 'Software práctico para negocios reales. Hecho en Colombia 🇨🇴' : 'Practical software for real businesses. Made in Colombia 🇨🇴'}
          </div>
        </div>
      </div>
    </footer>

    <!-- Opita Telemetry -->
    <script is:inline>
      (function(){
        var API="https://api.opitacode.com/core/events/ingest",PID="opitacode-web";
        var sid=sessionStorage.getItem("opita_session_id");
        if(!sid){sid=crypto.randomUUID();sessionStorage.setItem("opita_session_id",sid)}
        var q=[];
        function t(type,data){q.push({type:type,source:"landing",timestamp:new Date().toISOString(),data:data||{}});if(q.length>=10)f()}
        function f(){if(!q.length)return;var p=JSON.stringify({events:q.splice(0),sessionId:sid,productId:PID});if(navigator.sendBeacon){navigator.sendBeacon(API,p)}else{fetch(API,{method:"POST",headers:{"Content-Type":"application/json"},body:p,keepalive:true}).catch(function(){})}}
        var ps=new URLSearchParams(location.search);
        t("page_view",{url:location.pathname,referrer:document.referrer||"",utm_source:ps.get("utm_source"),utm_medium:ps.get("utm_medium"),utm_campaign:ps.get("utm_campaign")});
        t("session_start",{url:location.pathname});
        document.addEventListener("click",function(e){var el=e.target.closest("a,button");if(!el)return;var text=(el.textContent||"").trim().slice(0,80);var href=el.getAttribute("href")||"";if(text.includes("Trabajemos")||text.includes("Work")||href.includes("#contacto")||href.includes("#contact")){t("cta_click",{button:text,href:href,source_section:"trabajemos_juntos"})}});
        document.addEventListener("visibilitychange",function(){if(document.visibilityState==="hidden")f()});
        window.addEventListener("pagehide",f);
      })();
    </script>
  </body>
</html>
