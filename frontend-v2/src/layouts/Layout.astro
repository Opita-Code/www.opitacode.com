---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en';
  schema?: Record<string, any> | Record<string, any>[];
}

const { title, description, lang, schema } = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth scroll-pt-24">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Brand favicon: `>_` terminal prompt in violet (no graphical logo) -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2280%22 fill=%22%238b5cf6%22 font-family=%22monospace%22 font-weight=%22bold%22>>_</text></svg>" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- SEO & Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content="/og-image.jpg" />
    
    <!-- i18n Alternate Links -->
    <link rel="alternate" hreflang="es" href={`${Astro.site || ''}/es`} />
    <link rel="alternate" hreflang="en" href={`${Astro.site || ''}/en`} />
    <link rel="alternate" hreflang="x-default" href={`${Astro.site || ''}/es`} />

    <!-- JSON-LD -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Theme Manager -->
    <script is:inline>
      if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.add('light');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col font-sans">
    <header class="border-b border-border-base bg-bg-base/80 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href={`/${lang}`} class="brand-prompt text-2xl text-text-base flex items-center gap-2 group">
          <span class="prompt-caret">&gt;_</span>
          <span class="text-text-base transition-colors">OPITA&nbsp;CODE</span>
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent-primary transition-all group-hover:w-full shadow-[0_0_10px_rgba(139,92,246,0.8)]"></span>
        </a>
        <nav class="hidden md:flex gap-8 text-sm font-medium items-center">
          <a href={`/${lang}#ecosystem`} class="text-text-muted hover:text-text-base transition-colors">{lang === 'es' ? 'Ecosistema' : 'Ecosystem'}</a>
          <a href={`/${lang}#about`} class="text-text-muted hover:text-text-base transition-colors">{lang === 'es' ? 'Nosotros' : 'About'}</a>
          <a href={`/${lang}#contact`} class="text-text-muted hover:text-text-base transition-colors">{lang === 'es' ? 'Contacto' : 'Contact'}</a>
          <div class="h-4 w-px bg-border-base"></div>
          <a href="https://cuenta.opitacode.com" class="text-corporate-600 dark:text-corporate-400 hover:text-corporate-900 dark:hover:text-corporate-300 font-bold transition-colors">{lang === 'es' ? 'Mi Cuenta' : 'My Account'}</a>
        </nav>
        <div class="flex items-center gap-4">
          <div class="text-xs font-mono bg-bg-muted px-2 py-1 rounded text-text-muted border border-border-base flex items-center h-full">
            <a href="/es" class={lang === 'es' ? 'font-bold text-text-base' : ''}>ES</a>
            <span class="opacity-50 mx-1">/</span>
            <a href="/en" class={lang === 'en' ? 'font-bold text-text-base' : ''}>EN</a>
          </div>
          <ThemeToggle />
        </div>
      </div>
    </header>
    
    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-bg-muted border-t border-border-base py-12 mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="flex items-center gap-3">
          <span class="brand-prompt text-xl text-text-muted">
            <span class="prompt-caret">&gt;_</span>
          </span>
          <span class="text-sm text-text-muted font-medium">© {new Date().getFullYear()} Opita Code.</span>
        </div>
        <div class="text-sm text-corporate-700">
          {lang === 'es' ? 'Software práctico para negocios reales. Hecho en Colombia 🇨🇴' : 'Practical software for real businesses. Made in Colombia 🇨🇴'}
        </div>
      </div>
    </footer>

    <!-- Opita Telemetry -->
    <script is:inline>
      (function(){
        var API="https://api.opitacode.com/core/events/ingest",PID="opitacode-web";
        var sid=sessionStorage.getItem("opita_session_id");
        if(!sid){sid=crypto.randomUUID();sessionStorage.setItem("opita_session_id",sid)}
        var q=[];
        function t(type,data){q.push({type:type,source:"landing",timestamp:new Date().toISOString(),data:data||{}});if(q.length>=10)f()}
        function f(){if(!q.length)return;var p=JSON.stringify({events:q.splice(0),sessionId:sid,productId:PID});if(navigator.sendBeacon){navigator.sendBeacon(API,p)}else{fetch(API,{method:"POST",headers:{"Content-Type":"application/json"},body:p,keepalive:true}).catch(function(){})}}
        var ps=new URLSearchParams(location.search);
        t("page_view",{url:location.pathname,referrer:document.referrer||"",utm_source:ps.get("utm_source"),utm_medium:ps.get("utm_medium"),utm_campaign:ps.get("utm_campaign")});
        t("session_start",{url:location.pathname});
        document.addEventListener("click",function(e){var el=e.target.closest("a,button");if(!el)return;var text=(el.textContent||"").trim().slice(0,80);var href=el.getAttribute("href")||"";if(text.includes("Trabajemos")||text.includes("Work")||href.includes("#contacto")||href.includes("#contact")){t("cta_click",{button:text,href:href,source_section:"trabajemos_juntos"})}});
        document.addEventListener("visibilitychange",function(){if(document.visibilityState==="hidden")f()});
        window.addEventListener("pagehide",f);
      })();
    </script>
  </body>
</html>
