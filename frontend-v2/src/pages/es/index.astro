---
import Layout from '../../layouts/Layout.astro';
import { ContactForm } from '../../components/ContactForm';
---

<Layout 
  title="Opita Code | Software práctico para negocios reales"
  description="Construido desde Colombia con identidad local y ambición global. Ecosistema de productos de software."
  lang="es"
>
  <!-- Hero Section -->
  <section class="relative min-h-[92vh] flex items-center justify-center px-4 sm:px-6 lg:px-8 overflow-hidden pt-24 pb-20">
    <!-- Ambient glows (dev-site language) -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-violet-600/10 rounded-full blur-[150px] pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-cyan-600/10 rounded-full blur-[120px] pointer-events-none"></div>
    <!-- Dot grid -->
    <div class="absolute inset-0 dot-grid opacity-40 [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>

    <div class="max-w-4xl mx-auto w-full relative z-10 text-center">
      <!-- Eyebrow — release announcement -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-accent-primary-dim border border-accent-primary/30 text-accent-primary-soft font-mono text-sm mb-8">
        <span class="w-2 h-2 rounded-full bg-accent-primary animate-pulse"></span>
        dark-memory v2.11.0 · 49 tools · governance en vivo
      </div>

      <h1 class="text-5xl sm:text-6xl md:text-7xl font-display font-black text-text-base tracking-tight mb-6 leading-[1.1]">
        Software que se<br class="hidden sm:block" />
        <span class="glow-text text-accent-primary-soft">audita a sí mismo.</span>
      </h1>

      <p class="text-lg sm:text-xl text-text-muted max-w-2xl mx-auto mb-10 leading-relaxed">
        Infraestructura de governance para agentes de IA. Cada artefacto pasa por un juez antes de publicarse. Construido desde Colombia.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center gap-4 justify-center">
        <a href="#ecosystem" class="px-8 py-3.5 rounded-md bg-accent-primary text-white font-mono font-bold transition-all hover:bg-accent-primary-hover hover:scale-105 active:scale-95 shadow-[0_0_20px_rgba(139,92,246,0.35)] w-full sm:w-auto text-center">
          EXPLORAR_EL_KERNEL();
        </a>
        <a href="https://github.com/Opita-Code" target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 rounded-md bg-zinc-800/80 border border-zinc-700 text-text-base font-mono transition-all hover:border-accent-primary/50 hover:shadow-[0_0_15px_rgba(139,92,246,0.3)] w-full sm:w-auto text-center flex justify-center items-center gap-2 group">
          <svg class="w-5 h-5 text-text-muted group-hover:text-accent-primary-soft transition-colors" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          GITHUB
        </a>
      </div>

      <!-- Code snippet — live judge call -->
      <div class="mt-16 text-left">
        <div class="glass neon-border rounded-2xl overflow-hidden bg-bg-surface/90 shadow-2xl">
          <div class="flex items-center justify-between border-b border-border-base bg-bg-muted/60 px-4 py-3">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            </div>
            <span class="font-mono text-xs text-text-faint">judge.ts — drift_judge</span>
            <span class="font-mono text-xs text-status-online">● aligned</span>
          </div>
          <div class="p-5 sm:p-6 font-mono text-sm leading-relaxed text-text-muted overflow-x-auto bg-[#0d0d12]">
            <span class="text-accent-primary-soft">const</span> <span class="text-yellow-200">verdict</span> = <span class="text-accent-primary-soft">await</span> dark_memory.<span class="text-yellow-200">judge</span>(&#123;<br/>
            <span class="pl-4"></span>&nbsp;&nbsp;eval_type: <span class="text-status-online">'drift_judge'</span>,<br/>
            <span class="pl-4"></span>&nbsp;&nbsp;artifact: <span class="text-status-online">'spec-793 · hero'</span>,<br/>
            <span class="pl-4"></span>&nbsp;&nbsp;against: <span class="text-status-online">'spec-793'</span><br/>
            <span class="pl-4"></span>&#125;);<br/><br/>
            <span class="text-text-faint">// → verdict persistido en judgment_history</span><br/>
            <span class="text-accent-secondary-soft">verdict</span>: <span class="text-status-online">'aligned'</span>,<br/>
            <span class="text-accent-secondary-soft">confidence</span>: <span class="text-yellow-200">0.98</span>,<br/>
            <span class="text-accent-secondary-soft">drift</span>: <span class="text-text-faint">null</span><br/>
            <span class="inline-block w-2 h-4 bg-accent-primary mt-2 animate-pulse"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="servicios" class="py-24 bg-bg-muted border-b border-border-base">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-sm font-mono text-text-muted uppercase tracking-widest mb-3">Servicios</h2>
        <h3 class="text-3xl font-bold text-text-base">Qué hacemos</h3>
        <p class="mt-4 text-text-muted max-w-2xl mx-auto text-lg">
          Convertimos necesidades reales en sistemas funcionales. Estas son nuestras líneas de trabajo.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Desarrollo a Medida -->
        <div class="bg-bg-base p-8 rounded-xl border border-border-base shadow-sm">
          <div class="w-12 h-12 bg-bg-muted border border-border-base rounded-lg mb-6 flex items-center justify-center text-text-muted">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
            </svg>
          </div>
          <h4 class="text-xl font-bold mb-3 text-text-base">Desarrollo a Medida</h4>
          <p class="text-text-muted leading-relaxed">
            Aplicaciones web, paneles administrativos, APIs, integraciones y plataformas digitales diseñadas para tu operación.
          </p>
        </div>

        <!-- Automatización -->
        <div class="bg-bg-base p-8 rounded-xl border border-border-base shadow-sm">
          <div class="w-12 h-12 bg-bg-muted border border-border-base rounded-lg mb-6 flex items-center justify-center text-text-muted">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h4 class="text-xl font-bold mb-3 text-text-base">Automatización</h4>
          <p class="text-text-muted leading-relaxed">
            Conectamos tus herramientas, eliminamos tareas repetitivas y creamos flujos de trabajo eficientes que ahorran tiempo y reducen errores.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section id="proceso" class="py-24 bg-bg-base border-b border-border-base relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-sm font-mono text-text-muted uppercase tracking-widest mb-3">Proceso</h2>
        <h3 class="text-3xl font-bold text-text-base">Cómo trabajamos</h3>
        <p class="mt-4 text-text-muted max-w-2xl mx-auto text-lg">Tres pasos. De la idea al producto funcionando.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        <div class="hidden md:block absolute top-1/2 left-0 w-full h-px bg-border-base -translate-y-1/2 z-0"></div>
        
        <div class="bg-bg-base relative z-10 p-8 rounded-xl border border-border-base shadow-sm text-center">
          <div class="w-12 h-12 bg-corporate-900 text-bg-base rounded-full flex items-center justify-center font-bold text-xl mx-auto mb-6">1</div>
          <h4 class="text-xl font-bold mb-3 text-text-base">Escuchamos</h4>
          <p class="text-text-muted leading-relaxed">Entendemos tu negocio y el problema real que necesitas resolver. Sin jerga técnica, sin suposiciones.</p>
        </div>

        <div class="bg-bg-base relative z-10 p-8 rounded-xl border border-border-base shadow-sm text-center">
          <div class="w-12 h-12 bg-corporate-900 text-bg-base rounded-full flex items-center justify-center font-bold text-xl mx-auto mb-6">2</div>
          <h4 class="text-xl font-bold mb-3 text-text-base">Construimos</h4>
          <p class="text-text-muted leading-relaxed">Desarrollamos en ciclos cortos con hitos claros. Siempre sabes en qué punto estamos y qué sigue.</p>
        </div>

        <div class="bg-bg-base relative z-10 p-8 rounded-xl border border-border-base shadow-sm text-center">
          <div class="w-12 h-12 bg-corporate-900 text-bg-base rounded-full flex items-center justify-center font-bold text-xl mx-auto mb-6">3</div>
          <h4 class="text-xl font-bold mb-3 text-text-base">Entregamos</h4>
          <p class="text-text-muted leading-relaxed">Sistema funcionando, documentado y listo para escalar. Con soporte continuo y sin misterios.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ecosystem Grid -->
  <section id="ecosystem" class="py-24 bg-bg-muted border-b border-border-base">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-sm font-mono text-corporate-700 uppercase tracking-widest mb-3">Ecosistema</h2>
        <h3 class="text-3xl font-bold text-corporate-900">Productos Destacados</h3>
        <p class="mt-4 text-corporate-700 max-w-2xl mx-auto">Nuestra infraestructura central y plataformas públicas diseñadas con los mismos estándares de calidad que aplicamos a nuestros clientes.</p>
      </div>
      
      <!-- Developer Tools & Core -->
      <div class="mb-16">
        <div class="flex items-center gap-4 mb-8">
          <div class="h-px bg-border-base flex-1"></div>
          <h4 class="text-sm font-mono text-corporate-600 uppercase tracking-widest px-4">Infraestructura & DevTools</h4>
          <div class="h-px bg-border-base flex-1"></div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Vibe Studio Premium Card -->
          <a href="https://vibe.opitacode.com" target="_blank" rel="noopener noreferrer" class="group relative overflow-hidden bg-[#09090b] p-8 rounded-xl border border-white/10 dark:border-white/20 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl hover:shadow-purple-500/20 dark:shadow-2xl dark:shadow-black/50">
            
            <!-- Animated gradient background -->
            <div class="absolute inset-0 bg-gradient-to-br from-purple-500/10 via-transparent to-blue-500/10 opacity-50 group-hover:opacity-100 transition-opacity duration-500"></div>
            
            <!-- Spinning glowing border effect on hover -->
            <div class="absolute inset-[-100%] bg-[conic-gradient(from_90deg_at_50%_50%,transparent_0%,rgba(168,85,247,0.3)_50%,transparent_100%)] animate-spin opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
            <div class="absolute inset-[1px] bg-[#09090b] rounded-xl z-0 transition-colors duration-500 group-hover:bg-[#09090b]/90"></div>

            <!-- Ambient blur spot in the corner -->
            <div class="absolute -top-12 -right-12 w-32 h-32 bg-blue-500/20 rounded-full blur-3xl group-hover:bg-purple-500/30 transition-colors duration-700 z-0 pointer-events-none"></div>
            
            <!-- Card Content -->
            <div class="relative z-10 flex flex-col h-full">
              <div class="w-14 h-14 rounded-xl mb-6 overflow-hidden bg-black/50 border border-white/10 shadow-[0_8px_32px_rgba(168,85,247,0.15)] group-hover:shadow-[0_8px_32px_rgba(168,85,247,0.3)] group-hover:border-purple-500/40 transition-all duration-500 transform group-hover:scale-110 group-hover:-rotate-3">
                <img src="/vibe-logo.svg" alt="Opita Vibe Studio" class="w-full h-full object-cover scale-105" />
              </div>
              
              <div class="flex items-center gap-3 mb-2">
                <h4 class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400 group-hover:to-white transition-colors duration-300">Opita Vibe Studio</h4>
                <span class="text-[9px] font-bold tracking-widest bg-gradient-to-r from-purple-500/20 to-blue-500/20 text-purple-300 px-2.5 py-1 rounded-full border border-purple-500/30 backdrop-blur-md">FLAGSHIP</span>
              </div>
              
              <p class="text-purple-400 font-mono text-[11px] uppercase tracking-[0.2em] mb-4 opacity-80 group-hover:opacity-100 transition-opacity">El código fluye.</p>
              
              <p class="text-gray-400 text-sm leading-relaxed group-hover:text-gray-300 transition-colors duration-300 mt-auto">
                Entorno de desarrollo Vibe-coding en español para crear aplicaciones de producción asistidas por IA gobernada.
              </p>
            </div>
          </a>

          <!-- Opita OS Premium Card -->
          <a href="#" class="group relative overflow-hidden bg-[#020617] p-8 rounded-xl border border-slate-800 dark:border-slate-700 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl hover:shadow-cyan-500/20 dark:shadow-2xl dark:shadow-black/50">
            
            <!-- Subtle cyan radial glow -->
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(6,182,212,0.1),transparent_70%)] opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
            
            <!-- Spinning cyan-grey glowing border -->
            <div class="absolute inset-[-100%] bg-[conic-gradient(from_180deg_at_50%_50%,transparent_0%,rgba(6,182,212,0.4)_50%,transparent_100%)] animate-spin [animation-play-state:paused] group-hover:[animation-play-state:running] opacity-0 group-hover:opacity-100 transition-opacity duration-1000 pointer-events-none"></div>
            <div class="absolute inset-[1px] bg-[#020617] rounded-xl z-0 transition-colors duration-500 group-hover:bg-[#020617]/90"></div>

            <!-- Ambient blur spot in opposite corner -->
            <div class="absolute -bottom-12 -left-12 w-32 h-32 bg-slate-600/20 rounded-full blur-3xl group-hover:bg-cyan-500/20 transition-colors duration-700 z-0 pointer-events-none"></div>
            
            <!-- Card Content -->
            <div class="relative z-10 flex flex-col h-full">
              <div class="w-14 h-14 rounded-xl mb-6 flex items-center justify-center bg-slate-900/80 border border-slate-700/50 shadow-[0_8px_32px_rgba(6,182,212,0.1)] group-hover:shadow-[0_8px_32px_rgba(6,182,212,0.25)] group-hover:border-cyan-500/40 transition-all duration-500 transform group-hover:scale-110">
                <!-- Brand glyph: `>_` terminal prompt (typographic, no graphical logo) -->
                <span class="brand-prompt text-xl text-cyan-300"><span class="prompt-caret">&gt;_</span></span>
              </div>
              
              <div class="flex items-center gap-3 mb-2">
                <h4 class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-slate-200 to-slate-500 group-hover:to-slate-300 transition-colors duration-300">Opita OS</h4>
                <span class="text-[9px] font-bold tracking-widest bg-gradient-to-r from-cyan-500/20 to-slate-500/20 text-cyan-300 px-2.5 py-1 rounded-full border border-cyan-500/30 backdrop-blur-md">CORE</span>
              </div>
              
              <p class="text-cyan-400 font-mono text-[11px] uppercase tracking-[0.2em] mb-4 opacity-80 group-hover:opacity-100 transition-opacity">La base de todo.</p>
              
              <p class="text-slate-400 text-sm leading-relaxed group-hover:text-slate-300 transition-colors duration-300 mt-auto">
                El sistema operativo interno de la organización. Centraliza la fuente de la verdad (OpenSpec), el motor de marca, SSO y facturación del ecosistema.
              </p>
            </div>
          </a>

          <!-- Opita Studio (Hermano Mayor) -->
          <div class="group relative overflow-hidden bg-[#0a0a0a] p-8 rounded-xl border border-neutral-800 dark:border-neutral-700 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl hover:shadow-amber-500/10 dark:shadow-2xl dark:shadow-black/50">
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(245,158,11,0.15),transparent_50%)] opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
            
            <!-- Moving gold border -->
            <div class="absolute inset-[-100%] bg-[conic-gradient(from_45deg_at_50%_50%,transparent_0%,rgba(245,158,11,0.3)_50%,transparent_100%)] animate-spin [animation-play-state:paused] group-hover:[animation-play-state:running] opacity-0 group-hover:opacity-100 transition-opacity duration-1000 pointer-events-none" style="animation-duration: 8s;"></div>
            <div class="absolute inset-[1px] bg-[#0a0a0a] rounded-xl z-0 transition-colors duration-500 group-hover:bg-[#0a0a0a]/95"></div>
            
            <div class="relative z-10 flex flex-col h-full">
              <div class="w-14 h-14 rounded-xl mb-6 flex items-center justify-center bg-neutral-900/80 border border-neutral-700/50 shadow-[0_8px_32px_rgba(245,158,11,0.1)] group-hover:shadow-[0_8px_32px_rgba(245,158,11,0.25)] group-hover:border-amber-500/40 transition-all duration-500 transform group-hover:scale-110">
                <span class="text-2xl font-serif italic font-bold text-transparent bg-clip-text bg-gradient-to-br from-amber-400 to-amber-600">S</span>
              </div>
              
              <div class="flex items-center gap-3 mb-2">
                <h4 class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-neutral-200 to-neutral-500 group-hover:to-neutral-100 transition-colors duration-300">Opita Studio</h4>
                <span class="text-[9px] font-bold tracking-widest bg-gradient-to-r from-amber-500/20 to-orange-500/20 text-amber-400 px-2.5 py-1 rounded-full border border-amber-500/30 backdrop-blur-md">ENTERPRISE</span>
              </div>
              
              <p class="text-amber-500/80 font-mono text-[11px] uppercase tracking-[0.2em] mb-4 opacity-80 group-hover:opacity-100 transition-opacity">El hermano mayor.</p>
              
              <p class="text-neutral-400 text-sm leading-relaxed group-hover:text-neutral-300 transition-colors duration-300 mt-auto">
                Orquestador enterprise para equipos de desarrollo. Integra flujos de IA gobernada y automatizaciones CI/CD en la nube.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Business & Marketplaces -->
      <div>
        <div class="flex items-center gap-4 mb-8">
          <div class="h-px bg-border-base flex-1"></div>
          <h4 class="text-sm font-mono text-corporate-600 uppercase tracking-widest px-4">Marketplaces & Soluciones B2B</h4>
          <div class="h-px bg-border-base flex-1"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Opita Barber -->
          <a href="#" class="group relative overflow-hidden bg-bg-base dark:bg-bg-muted/50 p-8 rounded-xl border border-border-base dark:border-white/10 transition-all duration-500 hover:-translate-y-1 hover:shadow-xl hover:border-corporate-300 dark:hover:border-corporate-700 dark:shadow-xl dark:shadow-black/40">
            
            <div class="absolute inset-0 bg-gradient-to-br from-corporate-50/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 dark:from-corporate-900/20"></div>
            
            <div class="relative z-10 flex flex-col h-full">
              <div class="w-14 h-14 rounded-xl mb-6 flex items-center justify-center bg-bg-muted border border-border-base transition-all duration-500 transform group-hover:scale-110 group-hover:bg-corporate-50 dark:group-hover:bg-corporate-900/50">
                <svg class="w-6 h-6 text-text-muted group-hover:text-corporate-600 dark:group-hover:text-corporate-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z"></path></svg>
              </div>
              
              <div class="flex items-center gap-3 mb-2">
                <h4 class="text-2xl font-bold text-text-base group-hover:text-corporate-900 transition-colors duration-300 dark:group-hover:text-white">Opita Barber</h4>
                <span class="text-[9px] font-bold tracking-widest bg-corporate-100 text-corporate-800 px-2.5 py-1 rounded-full dark:bg-corporate-900/50 dark:text-corporate-200 border border-corporate-200 dark:border-corporate-800">MARKETPLACE</span>
              </div>
              
              <p class="text-text-muted font-mono text-[11px] uppercase tracking-[0.2em] mb-4">Conectando Estilos.</p>
              
              <p class="text-text-muted text-sm leading-relaxed mt-auto">
                Marketplace inteligente para barberías. Descubre profesionales, reserva turnos y permite a las barberías gestionar todo su negocio desde una sola app.
              </p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- About / Founder Section -->
  <section id="about" class="py-24 bg-bg-muted border-b border-border-base">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-bg-base rounded-2xl border border-border-base shadow-xl shadow-corporate-900/5 p-8 sm:p-12 flex flex-col md:flex-row gap-10 items-center">
        <div class="w-48 h-48 shrink-0 rounded-full overflow-hidden border-4 border-bg-muted">
          <img src="/founder.jpg" alt="Juan Nicolás Urrutia Salcedo" class="w-full h-full object-cover" />
        </div>
