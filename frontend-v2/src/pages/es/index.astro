---
import Layout from '../../layouts/Layout.astro';
import { ContactForm } from '../../components/ContactForm';
---

<Layout 
  title="Opita Code | Software práctico para negocios reales"
  description="Construido desde Colombia con identidad local y ambición global. Ecosistema de productos de software."
  lang="es"
>
  <!-- Hero Section -->
  <section class="relative min-h-[92vh] flex items-center justify-center px-4 sm:px-6 lg:px-8 overflow-hidden pt-24 pb-20">
    <!-- Ambient glows (dev-site language) -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-violet-600/10 rounded-full blur-[150px] pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-cyan-600/10 rounded-full blur-[120px] pointer-events-none"></div>
    <!-- Dot grid -->
    <div class="absolute inset-0 dot-grid opacity-40 [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>

    <div class="max-w-4xl mx-auto w-full relative z-10 text-center">
      <!-- Eyebrow — release announcement -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-accent-primary-dim border border-accent-primary/30 text-accent-primary-soft font-mono text-sm mb-8">
        <span class="w-2 h-2 rounded-full bg-accent-primary animate-pulse"></span>
        dark-memory v2.11.0 · 49 tools · governance en vivo
      </div>

      <h1 class="text-5xl sm:text-6xl md:text-7xl font-display font-black text-text-base tracking-tight mb-6 leading-[1.1]">
        Software que se<br class="hidden sm:block" />
        <span class="glow-text text-accent-primary-soft">audita a sí mismo.</span>
      </h1>

      <p class="text-lg sm:text-xl text-text-muted max-w-2xl mx-auto mb-10 leading-relaxed">
        Infraestructura de governance para agentes de IA. Cada artefacto pasa por un juez antes de publicarse. Construido desde Colombia.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center gap-4 justify-center">
        <a href="#ecosystem" class="px-8 py-3.5 rounded-md bg-accent-primary text-white font-mono font-bold transition-all hover:bg-accent-primary-hover hover:scale-105 active:scale-95 shadow-[0_0_20px_rgba(139,92,246,0.35)] w-full sm:w-auto text-center">
          EXPLORAR_EL_KERNEL();
        </a>
        <a href="https://github.com/Opita-Code" target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 rounded-md bg-zinc-800/80 border border-zinc-700 text-text-base font-mono transition-all hover:border-accent-primary/50 hover:shadow-[0_0_15px_rgba(139,92,246,0.3)] w-full sm:w-auto text-center flex justify-center items-center gap-2 group">
          <svg class="w-5 h-5 text-text-muted group-hover:text-accent-primary-soft transition-colors" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          GITHUB
        </a>
      </div>

      <!-- Code snippet — live judge call -->
      <div class="mt-16 text-left">
        <div class="glass neon-border rounded-2xl overflow-hidden bg-bg-surface/90 shadow-2xl">
          <div class="flex items-center justify-between border-b border-border-base bg-bg-muted/60 px-4 py-3">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            </div>
            <span class="font-mono text-xs text-text-faint">judge.ts — drift_judge</span>
            <span class="font-mono text-xs text-status-online">● aligned</span>
          </div>
          <div class="p-5 sm:p-6 font-mono text-sm leading-relaxed text-text-muted overflow-x-auto bg-[#0d0d12]">
            <span class="text-accent-primary-soft">const</span> <span class="text-yellow-200">verdict</span> = <span class="text-accent-primary-soft">await</span> dark_memory.<span class="text-yellow-200">judge</span>(&#123;<br/>
            <span class="pl-4"></span>&nbsp;&nbsp;eval_type: <span class="text-status-online">'drift_judge'</span>,<br/>
            <span class="pl-4"></span>&nbsp;&nbsp;artifact: <span class="text-status-online">'spec-793 · hero'</span>,<br/>
            <span class="pl-4"></span>&nbsp;&nbsp;against: <span class="text-status-online">'spec-793'</span><br/>
            <span class="pl-4"></span>&#125;);<br/><br/>
            <span class="text-text-faint">// → verdict persistido en judgment_history</span><br/>
            <span class="text-accent-secondary-soft">verdict</span>: <span class="text-status-online">'aligned'</span>,<br/>
            <span class="text-accent-secondary-soft">confidence</span>: <span class="text-yellow-200">0.98</span>,<br/>
            <span class="text-accent-secondary-soft">drift</span>: <span class="text-text-faint">null</span><br/>
            <span class="inline-block w-2 h-4 bg-accent-primary mt-2 animate-pulse"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="servicios" class="py-24 bg-bg-muted border-b border-border-base">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-sm font-mono text-text-muted uppercase tracking-widest mb-3">Servicios</h2>
        <h3 class="text-3xl font-bold text-text-base">Qué hacemos</h3>
        <p class="mt-4 text-text-muted max-w-2xl mx-auto text-lg">
          Convertimos necesidades reales en sistemas funcionales. Estas son nuestras líneas de trabajo.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Desarrollo a Medida -->
        <div class="bg-bg-base p-8 rounded-xl border border-border-base shadow-sm">
          <div class="w-12 h-12 bg-bg-muted border border-border-base rounded-lg mb-6 flex items-center justify-center text-text-muted">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
            </svg>
          </div>
          <h4 class="text-xl font-bold mb-3 text-text-base">Desarrollo a Medida</h4>
          <p class="text-text-muted leading-relaxed">
            Aplicaciones web, paneles administrativos, APIs, integraciones y plataformas digitales diseñadas para tu operación.
          </p>
        </div>

        <!-- Automatización -->
        <div class="bg-bg-base p-8 rounded-xl border border-border-base shadow-sm">
          <div class="w-12 h-12 bg-bg-muted border border-border-base rounded-lg mb-6 flex items-center justify-center text-text-muted">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h4 class="text-xl font-bold mb-3 text-text-base">Automatización</h4>
          <p class="text-text-muted leading-relaxed">
            Conectamos tus herramientas, eliminamos tareas repetitivas y creamos flujos de trabajo eficientes que ahorran tiempo y reducen errores.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section id="proceso" class="py-24 bg-bg-base border-b border-border-base relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-sm font-mono text-text-muted uppercase tracking-widest mb-3">Proceso</h2>
        <h3 class="text-3xl font-bold text-text-base">Cómo trabajamos</h3>
        <p class="mt-4 text-text-muted max-w-2xl mx-auto text-lg">Tres pasos. De la idea al producto funcionando.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        <div class="hidden md:block absolute top-1/2 left-0 w-full h-px bg-border-base -translate-y-1/2 z-0"></div>
        
        <div class="bg-bg-base relative z-10 p-8 rounded-xl border border-border-base shadow-sm text-center">
          <div class="w-12 h-12 bg-corporate-900 text-bg-base rounded-full flex items-center justify-center font-bold text-xl mx-auto mb-6">1</div>
          <h4 class="text-xl font-bold mb-3 text-text-base">Escuchamos</h4>
          <p class="text-text-muted leading-relaxed">Entendemos tu negocio y el problema real que necesitas resolver. Sin jerga técnica, sin suposiciones.</p>
        </div>

        <div class="bg-bg-base relative z-10 p-8 rounded-xl border border-border-base shadow-sm text-center">
          <div class="w-12 h-12 bg-corporate-900 text-bg-base rounded-full flex items-center justify-center font-bold text-xl mx-auto mb-6">2</div>
          <h4 class="text-xl font-bold mb-3 text-text-base">Construimos</h4>
          <p class="text-text-muted leading-relaxed">Desarrollamos en ciclos cortos con hitos claros. Siempre sabes en qué punto estamos y qué sigue.</p>
        </div>

        <div class="bg-bg-base relative z-10 p-8 rounded-xl border border-border-base shadow-sm text-center">
          <div class="w-12 h-12 bg-corporate-900 text-bg-base rounded-full flex items-center justify-center font-bold text-xl mx-auto mb-6">3</div>
          <h4 class="text-xl font-bold mb-3 text-text-base">Entregamos</h4>
          <p class="text-text-muted leading-relaxed">Sistema funcionando, documentado y listo para escalar. Con soporte continuo y sin misterios.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ecosystem Grid — Kernel + Vertical products -->
  <section id="ecosystem" class="py-24 bg-bg-surface/30 border-b border-border-base relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(139,92,246,0.06),transparent_60%)] pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-sm font-mono text-accent-primary-soft uppercase tracking-widest mb-3">&lt;ecosystem&gt;</h2>
        <h3 class="text-3xl sm:text-4xl font-display font-black text-text-base">Un kernel, muchos productos.</h3>
        <p class="mt-4 text-text-muted max-w-2xl mx-auto text-lg">Todo lo que construimos consume el mismo sistema nervioso: governance, memoria y vibe-flow.</p>
      </div>

      <!-- Kernel row (4 cards) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        <!-- dark-memory-mcp -->
        <a href="https://github.com/Opita-Code/dark-memory-mcp" target="_blank" rel="noopener noreferrer" class="group glass neon-border rounded-xl p-6 flex flex-col hover:-translate-y-1 transition-all duration-300">
          <div class="flex items-center justify-between mb-4">
            <span class="brand-prompt text-2xl"><span class="prompt-caret">&gt;_</span></span>
            <span class="text-[9px] font-bold tracking-widest bg-accent-primary-dim text-accent-primary-soft px-2.5 py-1 rounded-full border border-accent-primary/30">KERNEL</span>
          </div>
          <h4 class="font-display font-bold text-text-base mb-1">dark-memory-mcp</h4>
          <p class="text-accent-primary-soft font-mono text-[11px] uppercase tracking-[0.2em] mb-3">v2.11.0 · 49 tools</p>
          <p class="text-text-muted text-sm leading-relaxed mt-auto">Governance + memory + research como un set unificado de herramientas MCP. Cada artefacto se audita antes de publicarse.</p>
        </a>

        <!-- dark-research-mcp -->
        <a href="https://github.com/Opita-Code/dark-research-mcp" target="_blank" rel="noopener noreferrer" class="group glass rounded-xl p-6 flex flex-col hover:-translate-y-1 transition-all duration-300">
          <div class="flex items-center justify-between mb-4">
            <svg class="w-7 h-7 text-accent-secondary-soft" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <span class="text-[9px] font-bold tracking-widest bg-cyan-500/10 text-accent-secondary-soft px-2.5 py-1 rounded-full border border-cyan-500/30">KERNEL</span>
          </div>
          <h4 class="font-display font-bold text-text-base mb-1">dark-research-mcp</h4>
          <p class="text-accent-secondary-soft font-mono text-[11px] uppercase tracking-[0.2em] mb-3">13 backends OSINT</p>
          <p class="text-text-muted text-sm leading-relaxed mt-auto">CVE, dominios, IPs, papers, noticias, dark web. Investigación primaria con fuentes verificables.</p>
        </a>

        <!-- ocais -->
        <a href="https://github.com/Opita-Code/ocais" target="_blank" rel="noopener noreferrer" class="group glass rounded-xl p-6 flex flex-col hover:-translate-y-1 transition-all duration-300">
          <div class="flex items-center justify-between mb-4">
            <svg class="w-7 h-7 text-yellow-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            <span class="text-[9px] font-bold tracking-widest bg-yellow-500/10 text-yellow-200 px-2.5 py-1 rounded-full border border-yellow-500/30">SDK</span>
          </div>
          <h4 class="font-display font-bold text-text-base mb-1">ocais</h4>
          <p class="text-yellow-200 font-mono text-[11px] uppercase tracking-[0.2em] mb-3">npm v3.0.1</p>
          <p class="text-text-muted text-sm leading-relaxed mt-auto">SDK de streaming IA para AWS Lambda. Zero deps, TypeScript-first. El puente entre LLMs y serverless.</p>
        </a>

        <!-- opita-os (private) -->
        <div class="glass rounded-xl p-6 flex flex-col opacity-80">
          <div class="flex items-center justify-between mb-4">
            <svg class="w-7 h-7 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            <span class="text-[9px] font-bold tracking-widest bg-zinc-500/10 text-text-muted px-2.5 py-1 rounded-full border border-zinc-500/30">CORE · PRIVADO</span>
          </div>
          <h4 class="font-display font-bold text-text-base mb-1">opita-os</h4>
          <p class="text-text-muted font-mono text-[11px] uppercase tracking-[0.2em] mb-3">SSOT · vault · SSO</p>
          <p class="text-text-muted text-sm leading-relaxed mt-auto">El runtime privado: OpenSpec, Brand Engine, vault cifrado y SSO que sostienen a todo el ecosistema.</p>
        </div>
      </div>

      <!-- Vertical products row (4 cards) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Vibe Studio -->
        <a href="https://vibe.opitacode.com" target="_blank" rel="noopener noreferrer" class="group glass rounded-xl p-6 flex flex-col hover:-translate-y-1 transition-all duration-300 border-t-2 border-t-accent-primary/50">
          <div class="w-11 h-11 rounded-lg mb-4 overflow-hidden bg-bg-muted border border-border-base flex items-center justify-center">
            <img src="/vibe-logo.svg" alt="Vibe Studio" class="w-7 h-7 object-contain" />
          </div>
          <h4 class="font-display font-bold text-text-base mb-1">Vibe Studio</h4>
          <p class="text-text-muted font-mono text-[11px] uppercase tracking-[0.2em] mb-3">vibe.opitacode.com</p>
          <p class="text-text-muted text-sm leading-relaxed mt-auto">IDE de vibe-coding en español. Cada generación gobernada por el kernel.</p>
        </a>

        <!-- Opita Market -->
        <a href="https://market.opitacode.com" target="_blank" rel="noopener noreferrer" class="group glass rounded-xl p-6 flex flex-col hover:-translate-y-1 transition-all duration-300 border-t-2 border-t-accent-secondary/50">
          <div class="w-11 h-11 rounded-lg mb-4 bg-bg-muted border border-border-base flex items-center justify-center">
            <svg class="w-6 h-6 text-accent-secondary-soft" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
          </div>
          <h4 class="font-display font-bold text-text-base mb-1">Opita Market</h4>
          <p class="text-text-muted font-mono text-[11px] uppercase tracking-[0.2em] mb-3">market.opitacode.com</p>
          <p class="text-text-muted text-sm leading-relaxed mt-auto">Marketplace B2B+B2C colombiano con compliance Ley 1581 desde el día uno.</p>
        </a>

        <!-- Sociedad Opita -->
        <a href="https://sociedad.opitacode.com" target="_blank" rel="noopener noreferrer" class="group glass rounded-xl p-6 flex flex-col hover:-translate-y-1 transition-all duration-300 border-t-2 border-t-emerald-500/50">
          <div class="w-11 h-11 rounded-lg mb-4 bg-bg-muted border border-border-base flex items-center justify-center">
            <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </div>
          <h4 class="font-display font-bold text-text-base mb-1">Sociedad Opita</h4>
          <p class="text-text-muted font-mono text-[11px] uppercase tracking-[0.2em] mb-3">sociedad.opitacode.com</p>
          <p class="text-text-muted text-sm leading-relaxed mt-auto">Monumento digital vivo del opita. Dialecto, memoria y 41 perfiles psicométricos.</p>
        </a>

        <!-- Developer Web -->
        <a href="https://developer.opitacode.com" target="_blank" rel="noopener noreferrer" class="group glass rounded-xl p-6 flex flex-col hover:-translate-y-1 transition-all duration-300 border-t-2 border-t-violet-400/50">
          <div class="w-11 h-11 rounded-lg mb-4 bg-bg-muted border border-border-base flex items-center justify-center">
            <span class="brand-prompt text-lg"><span class="prompt-caret">&gt;_</span></span>
          </div>
          <h4 class="font-display font-bold text-text-base mb-1">Developer</h4>
          <p class="text-text-muted font-mono text-[11px] uppercase tracking-[0.2em] mb-3">developer.opitacode.com</p>
          <p class="text-text-muted text-sm leading-relaxed mt-auto">Identidad del Opita Developer. Terminal interactiva y arquitectura en vivo.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- About / Founder Section -->
  <section id="about" class="py-24 bg-bg-muted border-b border-border-base">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-bg-base rounded-2xl border border-border-base shadow-xl shadow-corporate-900/5 p-8 sm:p-12 flex flex-col md:flex-row gap-10 items-center">
        <div class="w-48 h-48 shrink-0 rounded-full overflow-hidden border-4 border-bg-muted">
          <img src="/founder.jpg" alt="Juan Nicolás Urrutia Salcedo" class="w-full h-full object-cover" />
        </div>
        <div class="text-center md:text-left">
          <h2 class="text-sm font-mono text-text-muted uppercase tracking-widest mb-2">Fundador</h2>
          <h3 class="text-3xl font-bold text-text-base mb-2">Juan Nicolás Urrutia</h3>
          <p class="text-lg font-medium text-corporate-900 mb-4 dark:text-text-muted">Desarrollador Principal</p>
          <p class="text-text-muted leading-relaxed text-lg">
            Colombiano, desarrollador de software y creador de Opita Code. Construyo tecnología práctica para negocios reales, hago streams en vivo sobre desarrollo y comparto lo que aprendo en el camino.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-24 bg-bg-base relative">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="mb-12">
        <h2 class="text-3xl font-bold mb-4 text-text-base">Trabajemos juntos</h2>
        <p class="text-text-muted text-lg">Déjanos un mensaje sobre el problema que quieres resolver. Responderemos en menos de 24 horas.</p>
      </div>
      
      <div class="bg-bg-muted p-8 rounded-2xl border border-border-base shadow-xl shadow-corporate-900/5">
        <ContactForm client:load lang="es" />
      </div>
    </div>
  </section>
</Layout>
