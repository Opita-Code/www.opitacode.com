---
import Layout from '../../layouts/Layout.astro';
import { ContactForm } from '../../components/ContactForm';
import SessionReplay from '../../components/SessionReplay.astro';
import { getReleases, relativeDate, excerpt } from '../../lib/releases';
import { EVIDENCE, KERNEL, SURFACE_LABELS, type SurfaceState } from '../../lib/metrics';

const releases = await getReleases(3);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Opita Code',
  url: 'https://www.opitacode.com',
  logo: 'https://www.opitacode.com/og-image.svg',
  description:
    'Infraestructura de memoria y governance para agentes de IA. Ecosistema open-source construido desde Neiva, Huila, Colombia.',
  foundingLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Neiva',
      addressRegion: 'Huila',
      addressCountry: 'CO',
    },
  },
  sameAs: [
    'https://github.com/Opita-Code',
    'https://www.npmjs.com/package/@opitacode/ocais',
    'https://cuentas.opitacode.com',
  ],
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'dark-memory-mcp',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows',
  description:
    'Servidor de memoria persistente y orquestación de flujo de trabajo para agentes de IA. 73 herramientas MCP en 20 namespaces, con juez de deriva anclado al artefacto.',
  codeRepository: 'https://github.com/Opita-Code/dark-memory-mcp',
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Organization', name: 'Opita Code' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const schema = [orgSchema, appSchema];

const SESSION = [
  {
    kind: 'cmd',
    segs: [
      { t: 'accent', s: '$ ' },
      { t: 'fn', s: 'dark_memory.session_start' },
      { t: 'arg', s: '(operator="INV-1", project_id="default")' },
    ],
  },
  {
    kind: 'out',
    segs: [
      { t: 'val', s: '→ sess-4d5486aec8421a86' },
      { t: 'dim', s: ' · constitution dark-agents/dark-mem@1.0.0 ✓' },
    ],
  },
  {
    kind: 'cmd',
    segs: [
      { t: 'accent', s: '$ ' },
      { t: 'fn', s: 'dark_memory.vibe_spec' },
      { t: 'arg', s: '(vibe_case="C2", tasks=[7])' },
    ],
  },
  {
    kind: 'out',
    segs: [
      { t: 'val', s: '→ spec 990' },
      { t: 'dim', s: ' · 7 tareas · intent persistida en la fila' },
    ],
  },
  {
    kind: 'cmd',
    segs: [
      { t: 'accent', s: '$ ' },
      { t: 'fn', s: 'dark_memory.vibe_publish' },
      { t: 'arg', s: '(spec=990, artifact="src/pages/es/index.astro")' },
    ],
  },
  {
    kind: 'out',
    segs: [
      { t: 'val', s: '→ artifact 606' },
      { t: 'dim', s: ' · drift 622' },
    ],
  },
  {
    kind: 'cmd',
    segs: [
      { t: 'accent', s: '$ ' },
      { t: 'fn', s: 'dark_memory.judge' },
      { t: 'arg', s: '(eval_type="drift_judge", artifact_ref=…, spec_intent=…)' },
    ],
  },
  {
    kind: 'out',
    segs: [
      { t: 'warn', s: '→ needs_human' },
      { t: 'dim', s: ' · evaluation 1081 · "nli: provider unavailable"' },
    ],
  },
  {
    kind: 'cmd',
    segs: [
      { t: 'accent', s: '$ ' },
      { t: 'fn', s: 'dark_memory.judge' },
      { t: 'arg', s: '(eval_type="drift_judge", content=…, spec_intent=…)' },
    ],
  },
  {
    kind: 'out',
    segs: [
      { t: 'warn', s: '→ drift_detected' },
      { t: 'dim', s: ' · conf 0.93 · evaluation 1083' },
    ],
  },
  {
    kind: 'out',
    segs: [
      { t: 'dim', s: '  "la página mostraba un veredicto de juez simulado" → corregido' },
    ],
  },
  {
    kind: 'out',
    segs: [
      { t: 'warn', s: '→ needs_human' },
      { t: 'dim', s: ' · conf 0.95 · evaluation 1084' },
    ],
  },
  {
    kind: 'out',
    segs: [
      { t: 'dim', s: '  "falta revisar los archivos omitidos" → se incluyeron layout, tokens y métricas' },
    ],
  },
  {
    kind: 'meta',
    segs: [
      {
        t: 'dim',
        s: 'sesión real · 28-10-2026 · 990 specs · 605 artefactos · 1.078 evaluaciones del juez',
      },
    ],
  },
];

const JUDGE = { verdict: 'drift_detected', confidence: '0.93', evaluation: '1083' };

const SESSION_CAPTION = "Sesión real de dark-memory, capturada el 28 de octubre de 2026. Cada línea es una llamada y su respuesta, con los identificadores que devolvió el servidor. Lo que se ve incluye el hallazgo del juez sobre esta misma página y su corrección. Cuando el juez no puede decidir, el veredicto es que hace falta una persona y el proceso se detiene.";

const SESSION_SUBJECT = "El artefacto juzgado es esta misma página. Los veredictos son las evaluaciones 1081, 1083 y 1084 de dark-memory.";


const kernelProducts: {
  name: string;
  meta: string;
  desc: string;
  href: string;
  tag: string;
}[] = [
  {
    name: 'vibe-tools',
    meta: 'Runtime · 4 de 10 loops cerrados',
    desc: 'El runtime en el que las herramientas se componen entre sí y la memoria se inyecta como contexto. Es el producto en construcción.',
    href: 'https://github.com/Opita-Code/opita-code',
    tag: 'RUNTIME',
  },

  {
    name: 'dark-memory-mcp',
    meta: 'v4.0.0-alpha.32 · 73 herramientas',
    desc: 'Memoria persistente, governance y workflow como un solo set de herramientas MCP. Cada artefacto se juzga antes de publicarse.',
    href: 'https://github.com/Opita-Code/dark-memory-mcp',
    tag: 'KERNEL',
  },
  {
    name: 'dark-research-mcp',
    meta: '13 backends OSINT',
    desc: 'CVE, dominios, IPs, certificados, papers, noticias. Investigación primaria con fuentes verificables y fecha.',
    href: 'https://github.com/Opita-Code/dark-research-mcp',
    tag: 'KERNEL',
  },
  {
    name: 'ocais',
    meta: 'npm 3.0.1 · zero deps',
    desc: 'SDK de streaming de IA para AWS Lambda. TypeScript primero. El puente entre los modelos y el serverless.',
    href: 'https://www.npmjs.com/package/@opitacode/ocais',
    tag: 'SDK',
  },
];

const verticalProducts: {
  name: string;
  meta: string;
  desc: string;
  href: string;
  state: SurfaceState;
}[] = [
  {
    name: 'Opita Saldo',
    meta: 'Billetera · saldo no retirable · L9',
    desc: 'La billetera interna con saldo que no se puede retirar, para recargas, impulso semanal y pagos dentro de la plataforma.',
    href: 'https://github.com/Opita-Code/opita-code/blob/main/docs/arquitectura/plan-iteracion-mvp.md',
    state: 'building',
  },

  {
    name: 'Vibe Studio',
    meta: 'IDE de vibe-coding en español',
    desc: 'Generación gobernada por el kernel: cada salida pasa por juez antes de llegar al usuario.',
    href: 'https://github.com/Opita-Code/opita-vibe-studio',
    state: 'building',
  },
  {
    name: 'Opita Market',
    meta: 'Marketplace B2B y B2C',
    desc: 'Directorio y comparador con cumplimiento de la Ley 1581 desde el primer día.',
    href: 'https://github.com/Opita-Code/opita-market',
    state: 'building',
  },
  {
    name: 'Sociedad Opita',
    meta: 'Monumento digital vivo',
    desc: 'Frontend Astro 6 y Tailwind 4 sobre un backend SST v3 con streaming propio.',
    href: 'https://github.com/Opita-Code/sociedad-opita-app',
    state: 'building',
  },
  {
    name: 'Developer',
    meta: 'Terminal y arquitectura en vivo',
    desc: 'La identidad pública del developer: lo que se puede leer, lo que se puede correr, lo que falta.',
    href: 'https://github.com/Opita-Code/opita-developer-web',
    state: 'building',
  },
];
---

<Layout
  title="Opita Code | Runtime de memoria y governance para agentes de IA"
  description="dark-memory-mcp: 73 herramientas open source para que los agentes de IA tengan memoria propia y cada entregable se juzgue antes de publicarse. Ecosistema construido desde Neiva, Huila, Colombia."
  lang="es"
  schema={schema}
>
  <!-- ══ HERO ══════════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden pt-28 pb-16 sm:pt-32 lg:pt-36 lg:pb-24">
    <div class="absolute inset-0 dot-grid opacity-[0.14] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-start">
        <!-- Columna de texto -->
        <div class="lg:col-span-5">
          <div
            class="inline-flex items-center gap-2 px-3 py-1.5 border border-accent/30 bg-accent/10 rounded-sm font-mono text-[11px] text-accent-ink mb-7"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true"></span>
            v4.0.0-alpha.32 · 73 herramientas · MIT
          </div>

          <h1
            class="font-display font-black text-text-base tracking-tight leading-[1.03] text-[2.55rem] sm:text-[3.4rem] lg:text-[3.75rem] mb-7"
          >
            Runtime de memoria y governance para agentes de IA.
          </h1>

          <p class="text-lg sm:text-xl text-text-muted leading-relaxed mb-9 max-w-xl">
            La memoria entra como contexto y ninguna herramienta puede leerla. Cada entregable se juzga contra su
            especificación antes de publicarse. Código abierto, escrito en Go, desde Neiva, Huila.
          </p>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 mb-8">
            <a
              href="https://github.com/Opita-Code/dark-memory-mcp"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-sm bg-accent text-white font-mono font-bold hover:brightness-110 transition-colors"
            >
              Explorar el kernel →
            </a>
            <a
              href="#contacto"
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-sm border border-border-strong text-text-base font-mono hover:border-accent-ink/60 transition-colors"
            >
              Hablar con el equipo
            </a>
          </div>

          <p class="font-mono text-[11.5px] text-text-faint leading-relaxed">
            MIT · Go 1.26 · 419 commits · 243 de 243 contribuciones de una sola persona
          </p>
        </div>

        <!-- Columna del terminal: la salida real del producto -->
        <div class="lg:col-span-7" data-reveal>
          <SessionReplay lines={SESSION} caption={SESSION_CAPTION} subject={SESSION_SUBJECT} />
        </div>
      </div>
    </div>
  </section>

  <!-- ══ EVIDENCIA ══════════════════════════════════════════════════════════ -->
  <section class="border-y border-border-base bg-bg-surface/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <p class="font-mono text-[11px] text-text-faint uppercase tracking-[0.18em] mb-8">
        El estado de este proyecto no se afirma: se mide
      </p>
      <dl class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-x-6 gap-y-8">
        {
          EVIDENCE.map((m) => (
            <div data-reveal>
              <dd class="font-display text-[2.6rem] leading-none font-bold text-text-base tabular-nums mb-2">{m.v}</dd>
              <dt class="text-[13px] text-text-muted leading-snug mb-1.5">{m.label.es}</dt>
              <p class="font-mono text-[10.5px] text-text-faint leading-snug">{m.src.es}</p>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ══ KERNEL ═════════════════════════════════════════════════════════════ -->
  <section id="kernel" class="py-24 bg-bg-base border-b border-border-base relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.10] pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mb-14" data-reveal>
        <p class="font-mono text-[11px] text-accent-ink uppercase tracking-[0.18em] mb-4">&lt;kernel&gt;</p>
        <h2 class="font-display font-black text-3xl sm:text-4xl text-text-base leading-[1.08] mb-5">
          Un sistema nervioso para agentes.
        </h2>
        <p class="text-lg text-text-muted leading-relaxed">
          dark-memory-mcp es la columna vertebral con la que escribimos software. Governance-as-code, no
          governance-as-policy: la regla se escribe, se ejecuta y queda registrada.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-14">
        <article class="border border-border-base rounded-sm p-6 bg-bg-surface/40" data-reveal>
          <p class="font-mono text-[11px] text-text-faint mb-3">01</p>
          <h3 class="font-display font-bold text-lg text-text-base mb-2.5">Escribe la spec</h3>
          <p class="text-[15px] text-text-muted leading-relaxed mb-5">
            Antes de una línea de código, la intención queda documentada con tareas, dependencias y criterios de
            aceptación.
          </p>
          <div class="font-mono text-[11.5px] leading-[1.9] bg-[#0b0d12] border border-border-base rounded-sm p-3.5 overflow-x-auto">
            <span class="text-accent-ink">dark_memory</span>.<span class="text-text-base">vibe_spec</span>(<br />
            &nbsp;&nbsp;vibe_case: <span class="text-status-online">'C1'</span>,<br />
            &nbsp;&nbsp;tasks: <span class="text-text-faint">[…]</span><br />
            )<br />
            <span class="text-text-faint">→ spec 990 · 7 tareas</span>
          </div>
        </article>

        <article class="border border-border-base rounded-sm p-6 bg-bg-surface/40" data-reveal style="--reveal-delay: 90ms">
          <p class="font-mono text-[11px] text-text-faint mb-3">02</p>
          <h3 class="font-display font-bold text-lg text-text-base mb-2.5">Un juez audita el artefacto</h3>
          <p class="text-[15px] text-text-muted leading-relaxed mb-5">
            LLM-as-judge, no LLM-as-author. El veredicto es aligned, drift_detected o needs_human; cuando el juez no
            puede decidir, el proceso se detiene hasta que alguien responda.
          </p>
          <div class="font-mono text-[11.5px] leading-[1.9] bg-[#0b0d12] border border-border-base rounded-sm p-3.5 overflow-x-auto">
            <span class="text-accent-ink">dark_memory</span>.<span class="text-text-base">judge</span>(<br />
            &nbsp;&nbsp;eval_type: <span class="text-status-online">'drift_judge'</span>,<br />
            &nbsp;&nbsp;artifact_ref: <span class="text-text-faint">[…]</span>,<br />
            &nbsp;&nbsp;spec_intent: <span class="text-text-faint">[…]</span><br />
            )<br />
            <span class="text-status-warn">→ {JUDGE.verdict}</span>{' '}
            <span class="text-text-faint">· conf {JUDGE.confidence} · eval {JUDGE.evaluation}</span>
          </div>
        </article>

        <article class="border border-border-base rounded-sm p-6 bg-bg-surface/40" data-reveal style="--reveal-delay: 180ms">
          <p class="font-mono text-[11px] text-text-faint mb-3">03</p>
          <h3 class="font-display font-bold text-lg text-text-base mb-2.5">Publica con rastro</h3>
          <p class="text-[15px] text-text-muted leading-relaxed mb-5">
            Quién escribió, contra qué spec, con qué juez y con qué veredicto. Nada sale a producción sin registro.
          </p>
          <div class="font-mono text-[11.5px] leading-[1.9] bg-[#0b0d12] border border-border-base rounded-sm p-3.5 overflow-x-auto">
            <span class="text-accent-ink">dark_memory</span>.<span class="text-text-base">vibe_publish</span>(<br />
            &nbsp;&nbsp;spec: <span class="text-text-faint">990</span>,<br />
            &nbsp;&nbsp;artifact: <span class="text-text-faint">[…]</span><br />
            )<br />
            <span class="text-text-faint">→ artifact 606 · drift 622</span>
          </div>
        </article>
      </div>

      <dl class="border border-border-base rounded-sm p-6 sm:p-9 bg-bg-surface/40 grid grid-cols-2 md:grid-cols-5 gap-x-6 gap-y-8">
        {
          KERNEL.map((m) => (
            <div>
              <dd class="font-display text-[2.4rem] leading-none font-bold text-text-base tabular-nums mb-2">{m.v}</dd>
              <dt class="text-[13px] text-text-muted leading-snug mb-1.5">{m.label.es}</dt>
              <p class="font-mono text-[10.5px] text-text-faint leading-snug">{m.src.es}</p>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ══ VIBE-FLOW ═══════════════════════════════════════════════════════════ -->
  <section id="vibe-flow" class="py-24 bg-bg-muted border-b border-border-base">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-16" data-reveal>
        <p class="font-mono text-[11px] text-accent-ink uppercase tracking-[0.18em] mb-4">&lt;vibe-flow&gt;</p>
        <h2 class="font-display font-black text-3xl sm:text-4xl text-text-base leading-[1.08] mb-5">
          Cómo se construye aquí.
        </h2>
        <p class="text-lg text-text-muted leading-relaxed">
          Cada producto de la organización nace del mismo ciclo de cinco etapas. Nada se salta el proceso. Esta
          página tampoco.
        </p>
      </div>

      <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-5">
        {
          [
            { n: '01', t: 'Spec', d: 'La intención se documenta antes del código.', accent: false },
            { n: '02', t: 'Artifact', d: 'Se construye y se registra con rastro completo.', accent: false },
            { n: '03', t: 'Drift', d: 'El juez compara el artefacto contra su spec.', accent: false },
            { n: '04', t: 'Reconcile', d: 'Si hay drift, se corrige y se vuelve a auditar.', accent: false },
            { n: '05', t: 'Publish', d: 'Solo sale a producción con veredicto conforme.', accent: true },
          ].map((s, i) => (
            <li class="relative" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <div
                class:list={[
                  'w-11 h-11 rounded-sm border flex items-center justify-center font-mono text-[11px] mb-4',
                  s.accent ? 'border-accent/50 text-accent-ink' : 'border-border-base text-text-faint',
                ]}
              >
                {s.n}
              </div>
              <h3 class="font-display font-bold text-text-base mb-1.5">{s.t}</h3>
              <p class="text-[14px] text-text-muted leading-relaxed">{s.d}</p>
            </li>
          ))
        }
      </ol>

      <p class="font-mono text-[12px] text-text-faint mt-14">LLM-as-judge, not LLM-as-author.</p>
    </div>
  </section>

  <!-- ══ ECOSISTEMA ══════════════════════════════════════════════════════════ -->
  <section id="ecosistema" class="py-24 bg-bg-base border-b border-border-base">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-14" data-reveal>
        <p class="font-mono text-[11px] text-accent-ink uppercase tracking-[0.18em] mb-4">&lt;ecosistema&gt;</p>
        <h2 class="font-display font-black text-3xl sm:text-4xl text-text-base leading-[1.08] mb-5">
          Un kernel, muchos productos.
        </h2>
        <p class="text-lg text-text-muted leading-relaxed">
          Todo lo que construimos consume el mismo sistema nervioso: memoria, governance y vibe-flow.
        </p>
      </div>

      <!-- Kernel -->
      <p class="font-mono text-[11px] text-text-faint uppercase tracking-[0.18em] mb-5">El kernel</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-16">
        {
          kernelProducts.map((p) => (
            <a
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group border border-border-base rounded-sm p-6 hover:border-accent-ink/40 transition-colors bg-bg-surface/40"
            >
              <div class="flex items-center justify-between mb-4">
                <h3 class="font-display font-bold text-text-base">{p.name}</h3>
                <span class="font-mono text-[9.5px] tracking-[0.16em] text-text-faint border border-border-base rounded-sm px-2 py-1">
                  {p.tag}
                </span>
              </div>
              <p class="font-mono text-[11px] text-accent-ink uppercase tracking-[0.14em] mb-3">{p.meta}</p>
              <p class="text-[14px] text-text-muted leading-relaxed">{p.desc}</p>
            </a>
          ))
        }
      </div>

      <!-- Productos verticales -->
      <p class="font-mono text-[11px] text-text-faint uppercase tracking-[0.18em] mb-5">Productos verticales</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          verticalProducts.map((p) => (
            <a
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group border border-border-base rounded-sm p-6 hover:border-accent-ink/40 transition-colors bg-bg-surface/40 flex flex-col"
            >
              <div class="flex items-center justify-between mb-4 gap-2">
                <h3 class="font-display font-bold text-text-base">{p.name}</h3>
                <span
                  class:list={[
                    'font-mono text-[9.5px] tracking-[0.12em] border rounded-sm px-2 py-1 whitespace-nowrap',
                    p.state === 'live'
                      ? 'text-status-online border-status-online/40'
                      : 'text-status-warn border-status-warn/40',
                  ]}
                >
                  {SURFACE_LABELS[p.state].es}
                </span>
              </div>
              <p class="font-mono text-[11px] text-accent-ink uppercase tracking-[0.14em] mb-3">{p.meta}</p>
              <p class="text-[14px] text-text-muted leading-relaxed">{p.desc}</p>
            </a>
          ))
        }
      </div>
      <p class="text-[13px] text-text-faint mt-6 leading-relaxed">
        Estado verificado el 28 de octubre de 2026. Los proyectos en construcción enlazan a su código: los
        subdominios públicos todavía no resuelven. Sociedad Opita, el monumento digital, sigue en el ecosistema;
        Opita Saldo es el loop L9 del plan y todavía no existe como producto publicado.
