---
import Layout from '../../layouts/Layout.astro';
import { ContactForm } from '../../components/ContactForm';
import { getReleases, relativeDate, excerpt } from '../../lib/releases';

const releases = await getReleases(3);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Opita Code',
  url: 'https://www.opitacode.com',
  logo: 'https://www.opitacode.com/og-image.svg',
  description: 'Governance infrastructure for AI agents. Open-source ecosystem built from Colombia.',
  foundingLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: 'Neiva', addressRegion: 'Huila', addressCountry: 'CO' } },
  sameAs: [
    'https://github.com/Opita-Code',
    'https://vibe.opitacode.com',
    'https://developer.opitacode.com',
  ],
};
---

<Layout 
  title="Opita Code | AI agent governance, built from Colombia"
  description="dark-memory-mcp: governance infrastructure for AI agents. Every artifact is audited before shipping. Open-source ecosystem built from Neiva, Huila, Colombia."
  lang="en"
  schema={orgSchema}
>
  <!-- Hero Section -->
  <section class="relative min-h-[92vh] flex items-center justify-center px-4 sm:px-6 lg:px-8 overflow-hidden pt-24 pb-20">
    <!-- Ambient glows (dev-site language) -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-violet-600/10 rounded-full blur-[150px] pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-cyan-600/10 rounded-full blur-[120px] pointer-events-none"></div>
    <!-- Dot grid -->
    <div class="absolute inset-0 dot-grid opacity-40 [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>

    <div class="max-w-4xl mx-auto w-full relative z-10 text-center">
      <!-- Eyebrow — release announcement -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-accent-primary-dim border border-accent-primary/30 text-accent-primary-soft font-mono text-sm mb-8">
        <span class="w-2 h-2 rounded-full bg-accent-primary animate-pulse"></span>
        dark-memory v2.11.0 · 49 tools · live governance
      </div>

      <h1 class="text-5xl sm:text-6xl md:text-7xl font-display font-black text-text-base tracking-tight mb-6 leading-[1.1]">
        Software that<br class="hidden sm:block" />
        <span class="glow-text text-accent-primary-soft">audits itself.</span>
      </h1>

      <p class="text-lg sm:text-xl text-text-muted max-w-2xl mx-auto mb-10 leading-relaxed">
        Governance infrastructure for AI agents. Every artifact goes through a judge before shipping. Built from Colombia.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center gap-4 justify-center">
        <a href="#ecosystem" class="px-8 py-3.5 rounded-md bg-accent-primary text-white font-mono font-bold transition-all hover:bg-accent-primary-hover hover:scale-105 active:scale-95 shadow-[0_0_20px_rgba(139,92,246,0.35)] w-full sm:w-auto text-center">
          EXPLORE_THE_KERNEL();
        </a>
        <a href="https://github.com/Opita-Code" target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 rounded-md bg-zinc-800/80 border border-zinc-700 text-text-base font-mono transition-all hover:border-accent-primary/50 hover:shadow-[0_0_15px_rgba(139,92,246,0.3)] w-full sm:w-auto text-center flex justify-center items-center gap-2 group">
          <svg class="w-5 h-5 text-text-muted group-hover:text-accent-primary-soft transition-colors" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          GITHUB
        </a>
      </div>

      <!-- Code snippet — live judge call -->
      <div class="mt-16 text-left">
        <div class="glass neon-border rounded-2xl overflow-hidden bg-bg-surface/90 shadow-2xl">
          <div class="flex items-center justify-between border-b border-border-base bg-bg-muted/60 px-4 py-3">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            </div>
            <span class="font-mono text-xs text-text-faint">judge.ts — drift_judge</span>
            <span class="font-mono text-xs text-status-online">● aligned</span>
          </div>
          <div class="p-5 sm:p-6 font-mono text-sm leading-relaxed text-text-muted overflow-x-auto bg-[#0d0d12]">
            <span class="text-accent-primary-soft">const</span> <span class="text-yellow-200">verdict</span> = <span class="text-accent-primary-soft">await</span> dark_memory.<span class="text-yellow-200">judge</span>(&#123;<br/>
            <span class="pl-4"></span>&nbsp;&nbsp;eval_type: <span class="text-status-online">'drift_judge'</span>,<br/>
            <span class="pl-4"></span>&nbsp;&nbsp;artifact: <span class="text-status-online">'spec-793 · hero'</span>,<br/>
            <span class="pl-4"></span>&nbsp;&nbsp;against: <span class="text-status-online">'spec-793'</span><br/>
            <span class="pl-4"></span>&#125;);<br/><br/>
            <span class="text-text-faint">// → verdict persisted to judgment_history</span><br/>
            <span class="text-accent-secondary-soft">verdict</span>: <span class="text-status-online">'aligned'</span>,<br/>
            <span class="text-accent-secondary-soft">confidence</span>: <span class="text-yellow-200">0.98</span>,<br/>
            <span class="text-accent-secondary-soft">drift</span>: <span class="text-text-faint">null</span><br/>
            <span class="inline-block w-2 h-4 bg-accent-primary mt-2 animate-pulse"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services" class="py-24 bg-bg-muted border-b border-border-base">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-sm font-mono text-text-muted uppercase tracking-widest mb-3">Services</h2>
        <h3 class="text-3xl font-bold text-text-base">What we do</h3>
        <p class="mt-4 text-text-muted max-w-2xl mx-auto text-lg">
          We turn real needs into functional systems. These are our lines of work.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Desarrollo a Medida -->
        <div class="bg-bg-base p-8 rounded-xl border border-border-base shadow-sm">
          <div class="w-12 h-12 bg-bg-muted border border-border-base rounded-lg mb-6 flex items-center justify-center text-text-muted">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
            </svg>
          </div>
          <h4 class="text-xl font-bold mb-3 text-text-base">Custom Development</h4>
          <p class="text-text-muted leading-relaxed">
            Web applications, administrative panels, APIs, integrations, and digital platforms designed for your operation.
          </p>
        </div>

        <!-- Automatización -->
        <div class="bg-bg-base p-8 rounded-xl border border-border-base shadow-sm">
          <div class="w-12 h-12 bg-bg-muted border border-border-base rounded-lg mb-6 flex items-center justify-center text-text-muted">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h4 class="text-xl font-bold mb-3 text-text-base">Automation</h4>
          <p class="text-text-muted leading-relaxed">
            We connect your tools, eliminate repetitive tasks, and create efficient workflows that save time and reduce errors.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How We Build — vibe-flow pipeline -->
  <section id="how-we-build" class="py-24 bg-bg-surface/30 border-b border-border-base relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,rgba(6,182,212,0.05),transparent_60%)] pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-sm font-mono text-accent-secondary-soft uppercase tracking-widest mb-3">&lt;how_we_build&gt;</h2>
        <h3 class="text-3xl sm:text-4xl font-display font-black text-text-base">Vibe-Flow: the pipeline.</h3>
        <p class="mt-4 text-text-muted max-w-2xl mx-auto text-lg">Every product in the organization is born from the same 5-stage cycle. Nothing skips the process — not even this page.</p>
      </div>

      <!-- 5-stage pipeline -->
      <div class="relative">
        <!-- Connector line (desktop) -->
        <div class="hidden lg:block absolute top-8 left-0 right-0 h-px bg-gradient-to-r from-accent-primary/0 via-accent-primary/40 to-accent-secondary/0"></div>
        
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
          <!-- Stage 1: Spec -->
          <div class="flex flex-col items-center text-center group">
            <div class="w-16 h-16 rounded-2xl glass border border-accent-primary/30 flex items-center justify-center mb-4 group-hover:shadow-[0_0_20px_rgba(139,92,246,0.3)] transition-shadow">
              <svg class="w-7 h-7 text-accent-primary-soft" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </div>
            <span class="font-mono text-xs text-accent-primary-soft mb-1">01</span>
            <h4 class="font-display font-bold text-text-base mb-1">Spec</h4>
            <p class="text-text-muted text-xs leading-relaxed">The intent is documented before any code.</p>
          </div>

          <!-- Stage 2: Artifact -->
          <div class="flex flex-col items-center text-center group">
            <div class="w-16 h-16 rounded-2xl glass border border-border-base flex items-center justify-center mb-4 group-hover:shadow-[0_0_20px_rgba(139,92,246,0.2)] transition-shadow">
              <svg class="w-7 h-7 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
            </div>
            <span class="font-mono text-xs text-text-muted mb-1">02</span>
            <h4 class="font-display font-bold text-text-base mb-1">Artifact</h4>
            <p class="text-text-muted text-xs leading-relaxed">Built and logged with a full trace.</p>
          </div>

          <!-- Stage 3: Drift -->
          <div class="flex flex-col items-center text-center group">
            <div class="w-16 h-16 rounded-2xl glass neon-border flex items-center justify-center mb-4 group-hover:shadow-[0_0_20px_rgba(139,92,246,0.35)] transition-shadow">
              <svg class="w-7 h-7 text-accent-primary-soft" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0L6 7m3-1L6 7m0 0L3 6m6-1L6 7m0 0L3 6m9 1h6m-6 4h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </div>
            <span class="font-mono text-xs text-accent-primary-soft mb-1">03</span>
            <h4 class="font-display font-bold text-text-base mb-1">Drift</h4>
            <p class="text-text-muted text-xs leading-relaxed">The judge compares artifact against spec.</p>
          </div>

          <!-- Stage 4: Reconcile -->
          <div class="flex flex-col items-center text-center group">
            <div class="w-16 h-16 rounded-2xl glass border border-border-base flex items-center justify-center mb-4 group-hover:shadow-[0_0_20px_rgba(6,182,212,0.2)] transition-shadow">
              <svg class="w-7 h-7 text-accent-secondary-soft" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            </div>
            <span class="font-mono text-xs text-accent-secondary-soft mb-1">04</span>
            <h4 class="font-display font-bold text-text-base mb-1">Reconcile</h4>
            <p class="text-text-muted text-xs leading-relaxed">On drift, fix and re-audit.</p>
          </div>

          <!-- Stage 5: Publish -->
          <div class="flex flex-col items-center text-center group">
            <div class="w-16 h-16 rounded-2xl glass border border-status-online/30 flex items-center justify-center mb-4 group-hover:shadow-[0_0_20px_rgba(34,197,94,0.25)] transition-shadow">
              <svg class="w-7 h-7 text-status-online" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="font-mono text-xs text-status-online mb-1">05</span>
            <h4 class="font-display font-bold text-text-base mb-1">Publish</h4>
            <p class="text-text-muted text-xs leading-relaxed">Ships to production only with aligned verdict.</p>
          </div>
        </div>
      </div>

      <!-- Process metrics -->
      <div class="mt-14 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
        <div class="text-center">
          <p class="font-mono text-3xl font-bold text-text-base">300+</p>
          <p class="text-xs font-mono text-text-faint uppercase tracking-widest mt-1">specs created</p>
        </div>
        <div class="w-px h-10 bg-border-base hidden sm:block"></div>
        <div class="text-center">
          <p class="font-mono text-3xl font-bold text-text-base">800+</p>
          <p class="text-xs font-mono text-text-faint uppercase tracking-widest mt-1">drift reports</p>
        </div>
        <div class="w-px h-10 bg-border-base hidden sm:block"></div>
        <div class="text-center">
          <p class="font-mono text-3xl font-bold text-text-base">12</p>
          <p class="text-xs font-mono text-text-faint uppercase tracking-widest mt-1">releases in 2026</p>
        </div>
        <div class="w-px h-10 bg-border-base hidden sm:block"></div>
        <div class="text-center">
          <p class="font-mono text-3xl font-bold text-text-base">1</p>
          <p class="text-xs font-mono text-text-faint uppercase tracking-widest mt-1">judge for everything</p>
        </div>
      </div>

      <blockquote class="mt-12 text-center font-mono text-sm text-text-faint">
        "LLM-as-judge, not LLM-as-author."
      </blockquote>
    </div>
  </section>

  <!-- Changelog preview — latest releases -->
  <section class="py-20 bg-bg-base border-b border-border-base relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6 mb-12">
        <div>
          <h2 class="text-sm font-mono text-accent-primary-soft uppercase tracking-widest mb-3">&lt;releases&gt;</h2>
          <h3 class="text-2xl sm:text-3xl font-display font-black text-text-base">We keep shipping. For real.</h3>
          <p class="mt-2 text-text-muted max-w-xl">Synced from GitHub on every build. This page went through the pipeline too.</p>
        </div>
        <a href={`/en/blog`} class="font-mono text-xs text-accent-primary-soft hover:text-text-base transition-colors inline-flex items-center gap-1.5">
          view all releases <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {releases.map((r) => (
          <article class="glass rounded-xl p-6 flex flex-col hover:border-accent-primary/40 transition-colors">
            <div class="flex items-center justify-between mb-3">
              <h4 class="font-mono font-bold text-lg text-text-base">{r.tag_name}</h4>
              <span class="text-[10px] font-mono text-text-faint bg-bg-muted border border-border-base px-2 py-0.5 rounded">
                {relativeDate(r.published_at, "en")}
              </span>
            </div>
            <p class="text-text-muted text-sm leading-relaxed flex-1">
              {excerpt(r.body, 160)}
            </p>
            <a href={r.html_url} target="_blank" rel="noopener noreferrer" class="mt-4 font-mono text-xs text-accent-primary-soft hover:text-text-base transition-colors inline-flex items-center gap-1.5">
              github <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Ecosystem Grid — Kernel + Vertical products -->
  <section id="ecosystem" class="py-24 bg-bg-surface/30 border-b border-border-base relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(139,92,246,0.06),transparent_60%)] pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-sm font-mono text-accent-primary-soft uppercase tracking-widest mb-3">&lt;ecosystem&gt;</h2>
        <h3 class="text-3xl sm:text-4xl font-display font-black text-text-base">One kernel, many products.</h3>
        <p class="mt-4 text-text-muted max-w-2xl mx-auto text-lg">Everything we build runs on the same nervous system: governance, memory, and vibe-flow.</p>
      </div>

      <!-- Kernel row (4 cards) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        <!-- dark-memory-mcp -->
        <a href="https://github.com/Opita-Code/dark-memory-mcp" target="_blank" rel="noopener noreferrer" class="group glass neon-border rounded-xl p-6 flex flex-col hover:-translate-y-1 transition-all duration-300">
          <div class="flex items-center justify-between mb-4">
            <span class="brand-prompt text-2xl"><span class="prompt-caret">&gt;_</span></span>
            <span class="text-[9px] font-bold tracking-widest bg-accent-primary-dim text-accent-primary-soft px-2.5 py-1 rounded-full border border-accent-primary/30">KERNEL</span>
          </div>
          <h4 class="font-display font-bold text-text-base mb-1">dark-memory-mcp</h4>
          <p class="text-accent-primary-soft font-mono text-[11px] uppercase tracking-[0.2em] mb-3">v2.11.0 · 49 tools</p>
          <p class="text-text-muted text-sm leading-relaxed mt-auto">Governance + memory + research as one unified MCP toolset. Every artifact is audited before it ships.</p>
        </a>

        <!-- dark-research-mcp -->
        <a href="https://github.com/Opita-Code/dark-research-mcp" target="_blank" rel="noopener noreferrer" class="group glass rounded-xl p-6 flex flex-col hover:-translate-y-1 transition-all duration-300">
          <div class="flex items-center justify-between mb-4">
            <svg class="w-7 h-7 text-accent-secondary-soft" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <span class="text-[9px] font-bold tracking-widest bg-cyan-500/10 text-accent-secondary-soft px-2.5 py-1 rounded-full border border-cyan-500/30">KERNEL</span>
          </div>
          <h4 class="font-display font-bold text-text-base mb-1">dark-research-mcp</h4>
          <p class="text-accent-secondary-soft font-mono text-[11px] uppercase tracking-[0.2em] mb-3">13 OSINT backends</p>
          <p class="text-text-muted text-sm leading-relaxed mt-auto">CVE, domains, IPs, papers, news, dark web. Primary-source research with verifiable findings.</p>
        </a>

        <!-- ocais -->
        <a href="https://github.com/Opita-Code/ocais" target="_blank" rel="noopener noreferrer" class="group glass rounded-xl p-6 flex flex-col hover:-translate-y-1 transition-all duration-300">
          <div class="flex items-center justify-between mb-4">
            <svg class="w-7 h-7 text-yellow-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            <span class="text-[9px] font-bold tracking-widest bg-yellow-500/10 text-yellow-200 px-2.5 py-1 rounded-full border border-yellow-500/30">SDK</span>
          </div>
          <h4 class="font-display font-bold text-text-base mb-1">ocais</h4>
          <p class="text-yellow-200 font-mono text-[11px] uppercase tracking-[0.2em] mb-3">npm v3.0.1</p>
          <p class="text-text-muted text-sm leading-relaxed mt-auto">AI streaming SDK for AWS Lambda. Zero deps, TypeScript-first. The bridge between LLMs and serverless.</p>
        </a>

        <!-- opita-os (private) -->
        <div class="glass rounded-xl p-6 flex flex-col opacity-80">
          <div class="flex items-center justify-between mb-4">
