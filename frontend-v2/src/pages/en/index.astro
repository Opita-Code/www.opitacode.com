---
import Layout from '../../layouts/Layout.astro';
import { ContactForm } from '../../components/ContactForm';
import SessionReplay from '../../components/SessionReplay.astro';
import { getReleases, relativeDate, excerpt } from '../../lib/releases';
import { EVIDENCE, KERNEL, SURFACE_LABELS, type SurfaceState } from '../../lib/metrics';

const releases = await getReleases(3);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Opita Code',
  url: 'https://www.opitacode.com',
  logo: 'https://www.opitacode.com/og-image.svg',
  description:
    'Memory and governance infrastructure for AI agents. An open-source ecosystem built from Neiva, Huila, Colombia.',
  foundingLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Neiva',
      addressRegion: 'Huila',
      addressCountry: 'CO',
    },
  },
  sameAs: [
    'https://github.com/Opita-Code',
    'https://www.npmjs.com/package/@opitacode/ocais',
    'https://cuentas.opitacode.com',
  ],
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'dark-memory-mcp',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows',
  description:
    'Persistent memory server and workflow orchestration for AI agents. 73 MCP tools across 20 namespaces, with artifact-anchored drift judging.',
  codeRepository: 'https://github.com/Opita-Code/dark-memory-mcp',
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Organization', name: 'Opita Code' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const schema = [orgSchema, appSchema];

const SESSION = [
  {
    kind: 'cmd',
    segs: [
      { t: 'accent', s: '$ ' },
      { t: 'fn', s: 'dark_memory.session_start' },
      { t: 'arg', s: '(operator="INV-1", project_id="default")' },
    ],
  },
  {
    kind: 'out',
    segs: [
      { t: 'val', s: '→ sess-4d5486aec8421a86' },
      { t: 'dim', s: ' · constitution dark-agents/dark-mem@1.0.0 ✓' },
    ],
  },
  {
    kind: 'cmd',
    segs: [
      { t: 'accent', s: '$ ' },
      { t: 'fn', s: 'dark_memory.vibe_spec' },
      { t: 'arg', s: '(vibe_case="C2", tasks=[7])' },
    ],
  },
  {
    kind: 'out',
    segs: [
      { t: 'val', s: '→ spec 990' },
      { t: 'dim', s: ' · 7 tareas · intent persistida en la fila' },
    ],
  },
  {
    kind: 'cmd',
    segs: [
      { t: 'accent', s: '$ ' },
      { t: 'fn', s: 'dark_memory.vibe_publish' },
      { t: 'arg', s: '(spec=990, artifact="src/pages/es/index.astro")' },
    ],
  },
  {
    kind: 'out',
    segs: [
      { t: 'val', s: '→ artifact 606' },
      { t: 'dim', s: ' · drift 622' },
    ],
  },
  {
    kind: 'cmd',
    segs: [
      { t: 'accent', s: '$ ' },
      { t: 'fn', s: 'dark_memory.judge' },
      { t: 'arg', s: '(eval_type="drift_judge", artifact_ref=…, spec_intent=…)' },
    ],
  },
  {
    kind: 'out',
    segs: [
      { t: 'warn', s: '→ needs_human' },
      { t: 'dim', s: ' · evaluation 1081 · "nli: provider unavailable"' },
    ],
  },
  {
    kind: 'cmd',
    segs: [
      { t: 'accent', s: '$ ' },
      { t: 'fn', s: 'dark_memory.judge' },
      { t: 'arg', s: '(eval_type="drift_judge", content=…, spec_intent=…)' },
    ],
  },
  {
    kind: 'out',
    segs: [
      { t: 'warn', s: '→ drift_detected' },
      { t: 'dim', s: ' · conf 0.93 · evaluation 1083' },
    ],
  },
  {
    kind: 'out',
    segs: [
      { t: 'dim', s: '  "la página mostraba un veredicto de juez simulado" → corregido' },
    ],
  },
  {
    kind: 'out',
    segs: [
      { t: 'warn', s: '→ needs_human' },
      { t: 'dim', s: ' · conf 0.95 · evaluation 1084' },
    ],
  },
  {
    kind: 'out',
    segs: [
      { t: 'dim', s: '  "falta revisar los archivos omitidos" → se incluyeron layout, tokens y métricas' },
    ],
  },
  {
    kind: 'meta',
    segs: [
      {
        t: 'dim',
        s: 'sesión real · 28-10-2026 · 990 specs · 605 artefactos · 1.078 evaluaciones del juez',
      },
    ],
  },
];

const JUDGE = { verdict: 'drift_detected', confidence: '0.93', evaluation: '1083' };

const SESSION_CAPTION = "A real dark-memory session, captured on October 28, 2026. Every line is a call and its response, with the identifiers the server returned. What you see includes the judge's finding on this very page and the fix. When the judge cannot decide, the verdict is that a person is needed and the process stops.";

const SESSION_SUBJECT = "The judged artifact is this very page. The verdicts are evaluations 1081, 1083 and 1084 in dark-memory.";


const kernelProducts: {
  name: string;
  meta: string;
  desc: string;
  href: string;
  tag: string;
}[] = [
  {
    name: 'vibe-tools',
    meta: 'Runtime · 4 of 10 loops closed',
    desc: 'The runtime where tools compose with each other and memory is injected as context. It is the product under construction.',
    href: 'https://github.com/Opita-Code/opita-code',
    tag: 'RUNTIME',
  },

  {
    name: 'dark-memory-mcp',
    meta: 'v4.0.0-alpha.32 · 73 tools',
    desc: 'Persistent memory, governance and workflow as a single set of MCP tools. Every artifact is judged before it ships.',
    href: 'https://github.com/Opita-Code/dark-memory-mcp',
    tag: 'KERNEL',
  },
  {
    name: 'dark-research-mcp',
    meta: '13 OSINT backends',
    desc: 'CVEs, domains, IPs, certificates, papers, news. Primary research with verifiable sources and dates.',
    href: 'https://github.com/Opita-Code/dark-research-mcp',
    tag: 'KERNEL',
  },
  {
    name: 'ocais',
    meta: 'npm 3.0.1 · zero deps',
    desc: 'AI streaming SDK for AWS Lambda. TypeScript first. The bridge between models and serverless.',
    href: 'https://www.npmjs.com/package/@opitacode/ocais',
    tag: 'SDK',
  },
];

const verticalProducts: {
  name: string;
  meta: string;
  desc: string;
  href: string;
  state: SurfaceState;
}[] = [
  {
    name: 'Opita Saldo',
    meta: 'Wallet · non-withdrawable balance · L9',
    desc: 'The internal wallet with a balance that cannot be withdrawn, for top-ups, the weekly impulse and payments inside the platform.',
    href: 'https://github.com/Opita-Code/opita-code/blob/main/docs/arquitectura/plan-iteracion-mvp.md',
    state: 'building',
  },

  {
    name: 'Vibe Studio',
    meta: 'A vibe-coding IDE in Spanish',
    desc: 'Generation governed by the kernel: every output passes the judge before it reaches the user.',
    href: 'https://github.com/Opita-Code/opita-vibe-studio',
    state: 'building',
  },
  {
    name: 'Opita Market',
    meta: 'B2B and B2C marketplace',
    desc: 'A directory and price comparator with Ley 1581 compliance from day one.',
    href: 'https://github.com/Opita-Code/opita-market',
    state: 'building',
  },
  {
    name: 'Sociedad Opita',
    meta: 'A living digital monument',
    desc: 'An Astro 6 and Tailwind 4 frontend over an SST v3 backend with its own streaming.',
    href: 'https://github.com/Opita-Code/sociedad-opita-app',
    state: 'building',
  },
  {
    name: 'Developer',
    meta: 'Terminal and live architecture',
    desc: 'The public developer identity: what can be read, what can be run, what is still missing.',
    href: 'https://github.com/Opita-Code/opita-developer-web',
    state: 'building',
  },
];
---

<Layout
  title="Opita Code | The memory and governance runtime for AI agents"
  description="dark-memory-mcp: 73 open-source tools so AI agents have memory of their own and every deliverable is judged before it ships. An ecosystem built from Neiva, Huila, Colombia."
  lang="en"
  schema={schema}
>
  <!-- ══ HERO ══════════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden pt-28 pb-16 sm:pt-32 lg:pt-36 lg:pb-24">
    <div class="absolute inset-0 dot-grid opacity-[0.14] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-start">
        <div class="lg:col-span-5">
          <div
            class="inline-flex items-center gap-2 px-3 py-1.5 border border-accent/30 bg-accent/10 rounded-sm font-mono text-[11px] text-accent-ink mb-7"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true"></span>
            v4.0.0-alpha.32 · 73 tools · MIT
          </div>

          <h1
            class="font-display font-black text-text-base tracking-tight leading-[1.03] text-[2.55rem] sm:text-[3.4rem] lg:text-[3.75rem] mb-7"
          >
            The memory and governance runtime for AI agents.
          </h1>

          <p class="text-lg sm:text-xl text-text-muted leading-relaxed mb-9 max-w-xl">
            Memory enters as context and no tool can read it back. Every deliverable is judged against its spec before
            it ships. Open source, written in Go, from Neiva, Huila.
          </p>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 mb-8">
            <a
              href="https://github.com/Opita-Code/dark-memory-mcp"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-sm bg-accent text-white font-mono font-bold hover:brightness-110 transition-colors"
            >
              Explore the kernel →
            </a>
            <a
              href="#contact"
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-sm border border-border-strong text-text-base font-mono hover:border-accent-ink/60 transition-colors"
            >
              Talk to the team
            </a>
          </div>

          <p class="font-mono text-[11.5px] text-text-faint leading-relaxed">
            MIT · Go 1.26 · 419 commits · 243 of 243 contributions from a single person
          </p>
        </div>

        <div class="lg:col-span-7" data-reveal>
          <SessionReplay lines={SESSION} caption={SESSION_CAPTION} subject={SESSION_SUBJECT} />
        </div>
      </div>
    </div>
  </section>

  <!-- ══ EVIDENCE ══════════════════════════════════════════════════════════ -->
  <section class="border-y border-border-base bg-bg-surface/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <p class="font-mono text-[11px] text-text-faint uppercase tracking-[0.18em] mb-8">
        This project's state is not asserted: it is measured
      </p>
      <dl class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-x-6 gap-y-8">
        {
          EVIDENCE.map((m) => (
            <div data-reveal>
              <dd class="font-display text-[2.6rem] leading-none font-bold text-text-base tabular-nums mb-2">{m.v}</dd>
              <dt class="text-[13px] text-text-muted leading-snug mb-1.5">{m.label.en}</dt>
              <p class="font-mono text-[10.5px] text-text-faint leading-snug">{m.src.en}</p>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ══ KERNEL ═════════════════════════════════════════════════════════════ -->
  <section id="kernel" class="py-24 bg-bg-base border-b border-border-base relative overflow-hidden">
    <div class="absolute inset-0 dot-grid opacity-[0.10] pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mb-14" data-reveal>
        <p class="font-mono text-[11px] text-accent-ink uppercase tracking-[0.18em] mb-4">&lt;kernel&gt;</p>
        <h2 class="font-display font-black text-3xl sm:text-4xl text-text-base leading-[1.08] mb-5">
          A nervous system for agents.
        </h2>
        <p class="text-lg text-text-muted leading-relaxed">
          dark-memory-mcp is the backbone we write software with. Governance-as-code, not governance-as-policy: the
          rule is written, it is executed, and it is recorded.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-14">
        <article class="border border-border-base rounded-sm p-6 bg-bg-surface/40" data-reveal>
          <p class="font-mono text-[11px] text-text-faint mb-3">01</p>
          <h3 class="font-display font-bold text-lg text-text-base mb-2.5">Write the spec</h3>
          <p class="text-[15px] text-text-muted leading-relaxed mb-5">
            Before a single line of code, the intent is documented with tasks, dependencies and acceptance criteria.
          </p>
          <div class="font-mono text-[11.5px] leading-[1.9] surface-dark border border-border-base rounded-sm p-3.5 overflow-x-auto">
            <span class="text-accent-ink">dark_memory</span>.<span class="text-text-base">vibe_spec</span>(<br />
            &nbsp;&nbsp;vibe_case: <span class="text-status-online">'C1'</span>,<br />
            &nbsp;&nbsp;tasks: <span class="text-text-faint">[…]</span><br />
            )<br />
            <span class="text-text-faint">→ spec 990 · 7 tasks</span>
          </div>
        </article>

        <article class="border border-border-base rounded-sm p-6 bg-bg-surface/40" data-reveal style="--reveal-delay: 90ms">
          <p class="font-mono text-[11px] text-text-faint mb-3">02</p>
          <h3 class="font-display font-bold text-lg text-text-base mb-2.5">A judge audits the artifact</h3>
          <p class="text-[15px] text-text-muted leading-relaxed mb-5">
            LLM-as-judge, not LLM-as-author. The verdict is aligned, drift_detected or needs_human; when the judge
            cannot decide, the process stops until someone answers.
          </p>
          <div class="font-mono text-[11.5px] leading-[1.9] surface-dark border border-border-base rounded-sm p-3.5 overflow-x-auto">
            <span class="text-accent-ink">dark_memory</span>.<span class="text-text-base">judge</span>(<br />
            &nbsp;&nbsp;eval_type: <span class="text-status-online">'drift_judge'</span>,<br />
            &nbsp;&nbsp;artifact_ref: <span class="text-text-faint">[…]</span>,<br />
            &nbsp;&nbsp;spec_intent: <span class="text-text-faint">[…]</span><br />
            )<br />
            <span class="text-status-warn">→ {JUDGE.verdict}</span>{' '}
            <span class="text-text-faint">· conf {JUDGE.confidence} · eval {JUDGE.evaluation}</span>
          </div>
        </article>

        <article class="border border-border-base rounded-sm p-6 bg-bg-surface/40" data-reveal style="--reveal-delay: 180ms">
          <p class="font-mono text-[11px] text-text-faint mb-3">03</p>
          <h3 class="font-display font-bold text-lg text-text-base mb-2.5">Publish with a trail</h3>
          <p class="text-[15px] text-text-muted leading-relaxed mb-5">
            Who wrote it, against which spec, with which judge and which verdict. Nothing ships without a record.
          </p>
          <div class="font-mono text-[11.5px] leading-[1.9] surface-dark border border-border-base rounded-sm p-3.5 overflow-x-auto">
            <span class="text-accent-ink">dark_memory</span>.<span class="text-text-base">vibe_publish</span>(<br />
            &nbsp;&nbsp;spec: <span class="text-text-faint">990</span>,<br />
            &nbsp;&nbsp;artifact: <span class="text-text-faint">[…]</span><br />
            )<br />
            <span class="text-text-faint">→ artifact 606 · drift 622</span>
          </div>
        </article>
      </div>

      <dl class="border border-border-base rounded-sm p-6 sm:p-9 bg-bg-surface/40 grid grid-cols-2 md:grid-cols-5 gap-x-6 gap-y-8">
        {
          KERNEL.map((m) => (
            <div>
              <dd class="font-display text-[2.6rem] leading-none font-bold text-text-base tabular-nums mb-2">{m.v}</dd>
              <dt class="text-[13px] text-text-muted leading-snug mb-1.5">{m.label.en}</dt>
              <p class="font-mono text-[10.5px] text-text-faint leading-snug">{m.src.en}</p>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ══ VIBE-FLOW ═══════════════════════════════════════════════════════════ -->
  <section id="vibe-flow" class="py-24 bg-bg-muted border-b border-border-base">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-16" data-reveal>
        <p class="font-mono text-[11px] text-accent-ink uppercase tracking-[0.18em] mb-4">&lt;vibe-flow&gt;</p>
        <h2 class="font-display font-black text-3xl sm:text-4xl text-text-base leading-[1.08] mb-5">
          How things get built here.
        </h2>
        <p class="text-lg text-text-muted leading-relaxed">
          Every product in the organization comes out of the same five-stage cycle. Nothing skips the process. This
          page didn't either.
        </p>
      </div>

      <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-5">
        {
          [
            { n: '01', t: 'Spec', d: 'Intent is documented before code.', accent: false },
            { n: '02', t: 'Artifact', d: 'It is built and logged with a full trail.', accent: false },
            { n: '03', t: 'Drift', d: 'The judge compares the artifact against its spec.', accent: false },
            { n: '04', t: 'Reconcile', d: 'If there is drift, it is fixed and audited again.', accent: false },
            { n: '05', t: 'Publish', d: 'It only ships with a compliant verdict.', accent: true },
          ].map((s, i) => (
            <li class="relative" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <div
                class:list={[
                  'w-11 h-11 rounded-sm border flex items-center justify-center font-mono text-[11px] mb-4',
                  s.accent ? 'border-accent/50 text-accent-ink' : 'border-border-base text-text-faint',
                ]}
              >
                {s.n}
              </div>
              <h3 class="font-display font-bold text-text-base mb-1.5">{s.t}</h3>
              <p class="text-[14px] text-text-muted leading-relaxed">{s.d}</p>
            </li>
          ))
        }
      </ol>

      <p class="font-mono text-[12px] text-text-faint mt-14">LLM-as-judge, not LLM-as-author.</p>
    </div>
  </section>

  <!-- ══ ECOSYSTEM ══════════════════════════════════════════════════════════ -->
  <section id="ecosystem" class="py-24 bg-bg-base border-b border-border-base">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-14" data-reveal>
        <p class="font-mono text-[11px] text-accent-ink uppercase tracking-[0.18em] mb-4">&lt;ecosystem&gt;</p>
        <h2 class="font-display font-black text-3xl sm:text-4xl text-text-base leading-[1.08] mb-5">
          One kernel, many products.
        </h2>
        <p class="text-lg text-text-muted leading-relaxed">
          Everything we build consumes the same nervous system: memory, governance and vibe-flow.
        </p>
      </div>

      <p class="font-mono text-[11px] text-text-faint uppercase tracking-[0.18em] mb-5">The kernel</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-16">
        {
          kernelProducts.map((p) => (
            <a
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group border border-border-base rounded-sm p-6 hover:border-accent-ink/40 transition-colors bg-bg-surface/40"
            >
              <div class="flex items-center justify-between mb-4">
                <h3 class="font-display font-bold text-text-base">{p.name}</h3>
                <span class="font-mono text-[9.5px] tracking-[0.16em] text-text-faint border border-border-base rounded-sm px-2 py-1">
                  {p.tag}
                </span>
              </div>
              <p class="font-mono text-[11px] text-accent-ink uppercase tracking-[0.14em] mb-3">{p.meta}</p>
              <p class="text-[14px] text-text-muted leading-relaxed">{p.desc}</p>
            </a>
          ))
        }
      </div>

      <p class="font-mono text-[11px] text-text-faint uppercase tracking-[0.18em] mb-5">Vertical products</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          verticalProducts.map((p) => (
            <a
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group border border-border-base rounded-sm p-6 hover:border-accent-ink/40 transition-colors bg-bg-surface/40 flex flex-col"
            >
              <div class="flex items-center justify-between mb-4 gap-2">
                <h3 class="font-display font-bold text-text-base">{p.name}</h3>
                <span
                  class:list={[
                    'font-mono text-[9.5px] tracking-[0.12em] border rounded-sm px-2 py-1 whitespace-nowrap',
                    p.state === 'live'
                      ? 'text-status-online border-status-online/40'
                      : 'text-status-warn border-status-warn/40',
                  ]}
                >
                  {SURFACE_LABELS[p.state].en}
                </span>
              </div>
              <p class="font-mono text-[11px] text-accent-ink uppercase tracking-[0.14em] mb-3">{p.meta}</p>
              <p class="text-[14px] text-text-muted leading-relaxed">{p.desc}</p>
            </a>
          ))
        }
      </div>
      <p class="text-[13px] text-text-faint mt-6 leading-relaxed">
        Status verified on October 28, 2026. Projects under construction link to their code: the public subdomains do
        not resolve yet. Sociedad Opita, the digital monument, remains in the ecosystem; Opita Saldo is plan loop L9 and
        does not exist as a published product yet.
      </p>
    </div>
  </section>

  <!-- ══ RELEASES ═══════════════════════════════════════════════════════════ -->
  <section class="py-20 bg-bg-muted border-b border-border-base">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6 mb-12" data-reveal>
        <div>
          <p class="font-mono text-[11px] text-accent-ink uppercase tracking-[0.18em] mb-4">&lt;releases&gt;</p>
          <h2 class="font-display font-black text-2xl sm:text-3xl text-text-base">We ship without pausing.</h2>
          <p class="mt-3 text-text-muted max-w-xl">
            Synced from GitHub on every build. This page went through the pipeline too.
          </p>
        </div>
        <a
          href="/en/blog"
          class="font-mono text-[12px] text-accent-ink hover:text-text-base transition-colors inline-flex items-center gap-1.5"
        >
          see all releases <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {
          releases.map((r) => (
