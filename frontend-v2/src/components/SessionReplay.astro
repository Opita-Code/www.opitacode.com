---
/**
 * Terminal de sesión real.
 *
 * No es una animación: reproduce una transcripción capturada de dark-memory,
 * con los identificadores que devolvió el servidor. La transcripción vive en la
 * propia página (no en un módulo aparte) para que quien lea el código pueda
 * verificar la procedencia sin saltar a otro archivo.
 */
interface Segment {
  t: 'plain' | 'fn' | 'arg' | 'val' | 'ok' | 'dim' | 'accent' | 'warn';
  s: string;
}

interface SessionLine {
  kind: 'cmd' | 'out' | 'meta';
  segs: Segment[];
}

interface Props {
  lines: SessionLine[];
  caption: string;
  subject: string;
}

const { lines, caption, subject } = Astro.props;

const SEG_CLASS: Record<Segment['t'], string> = {
  plain: 'text-text-muted',
  fn: 'text-text-base',
  arg: 'text-text-faint',
  val: 'text-text-base',
  ok: 'text-status-online',
  dim: 'text-text-faint',
  accent: 'text-accent-ink',
  warn: 'text-status-warn',
};

const LINE_CLASS: Record<SessionLine['kind'], string> = {
  cmd: 'text-text-muted',
  out: 'text-text-muted',
  meta: 'text-text-faint',
};
---

<div class="border border-border-base rounded-sm bg-[#0b0d12] overflow-hidden">
  <!-- Cabecera del terminal -->
  <div class="flex items-center justify-between gap-3 px-4 py-2.5 border-b border-border-base bg-bg-surface/50">
    <div class="flex items-center gap-2.5 min-w-0">
      <span class="w-1.5 h-1.5 rounded-full bg-accent shrink-0" aria-hidden="true"></span>
      <span class="font-mono text-[11px] text-text-faint truncate">dark-memory · MCP</span>
    </div>
    <span class="font-mono text-[11px] text-status-online shrink-0">● veredicto real</span>
  </div>

  <!-- Transcripción -->
  <div class="p-4 sm:p-5 font-mono text-[12px] sm:text-[12.5px] leading-[1.85] overflow-x-auto">
    {
      lines.map((line) => (
        <div
          class:list={[
            'whitespace-pre',
            LINE_CLASS[line.kind],
            line.kind === 'meta' && 'mt-4 pt-3 border-t border-border-base/60',
          ]}
        >
          {line.segs.map((seg) => (
            <span class={SEG_CLASS[seg.t]}>{seg.s}</span>
          ))}
        </div>
      ))
    }
  </div>

  <!-- Pie -->
  <div class="px-4 py-3 border-t border-border-base bg-bg-surface/50">
    <p class="text-[11.5px] text-text-muted leading-relaxed">{caption}</p>
    <p class="text-[11.5px] text-text-faint leading-relaxed mt-1">{subject}</p>
  </div>
</div>
