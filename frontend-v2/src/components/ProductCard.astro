---
/**
 * ProductCard — renderiza un producto desde products.json.
 * Para status='in_development' muestra badge 'EN DESARROLLO' + CTA WhatsApp
 * pre-rellenado. Para status='live' muestra link directo al producto.
 */
import { t, type Lang } from '../i18n';
import type { Product } from '../data/types';
import { ctaUrlForProduct } from '../data/types';

interface Props {
  product: Product;
  lang: Lang;
}

const { product, lang } = Astro.props;

const status = product.status;
const badge = product.badge;
const ctaUrl = ctaUrlForProduct(product, lang);
const isWhatsApp = ctaUrl.startsWith('https://wa.me/');
const ctaLabel = lang === 'es' ? product.cta_label_es : product.cta_label_en;
const tagline = lang === 'es' ? product.tagline_es : product.tagline_en;
const description = lang === 'es' ? product.description_es : product.description_en;

const cardColors: Record<string, string> = {
  warm: 'border-corporate-200 dark:border-corporate-800 hover:border-corporate-400',
  cool: 'border-blue-200 dark:border-blue-800 hover:border-blue-400',
  neutral: 'border-gray-200 dark:border-gray-700 hover:border-gray-400',
  corporate: 'border-corporate-300 dark:border-corporate-700 hover:border-corporate-500',
};

const badgeColors: Record<string, string> = {
  live: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
  in_development: 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
  internal: 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200',
};

const colorClass = cardColors[product.color] ?? cardColors.neutral;
const liveBadgeClass = badgeColors.live;
const devBadgeClass = badgeColors.in_development;
---

<article
  class={`relative bg-bg-base border ${colorClass} rounded-lg p-6 transition-all hover:shadow-md`}
  data-product-id={product.id}
  data-product-status={status}
>
  {badge && (
    <span class={`absolute top-3 right-3 text-xs font-bold px-2 py-1 rounded ${status === 'in_development' ? devBadgeClass : liveBadgeClass}`}>
      {badge}
    </span>
  )}
  <h3 class="text-xl font-bold mb-2 pr-16">{product.name}</h3>
  <p class="text-sm text-text-muted mb-3">{tagline}</p>
  <p class="text-sm text-text-base mb-4">{description}</p>
  <a
    href={ctaUrl}
    target={isWhatsApp ? '_blank' : undefined}
    rel={isWhatsApp ? 'noopener noreferrer' : undefined}
    data-product-cta={product.id}
    class={`inline-flex items-center gap-1 text-sm font-medium ${isWhatsApp ? 'text-green-700 hover:text-green-900 dark:text-green-400 dark:hover:text-green-200' : 'text-corporate-700 hover:text-corporate-900 dark:text-corporate-400 dark:hover:text-corporate-200'}`}
    aria-label={`${ctaLabel} — ${product.name}`}
  >
    {ctaLabel}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3" aria-hidden="true">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
  </a>
</article>
